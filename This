    lockBtn.TextColor3 = C.sub
    lockBtn.TextSize = 12
    lockBtn.Font = FONT_ICON
    lockBtn.AutoButtonColor = false
    lockBtn.BorderSizePixel = 0
    lockBtn.ZIndex = 12
    lockBtn.Parent = row
    Instance.new("UICorner", lockBtn).CornerRadius = UDim.new(0, 6)

    local lockStroke = Instance.new("UIStroke")
    lockStroke.Color = C.border
    lockStroke.Thickness = 1
    lockStroke.Transparency = 0.7
    lockStroke.Parent = lockBtn

    -- Visibility toggle
    local visBtn = Instance.new("TextButton")
    visBtn.Size = UDim2.fromOffset(20, 20)
    visBtn.Position = UDim2.new(1, -140, 0, 19)
    visBtn.BackgroundColor3 = C.panel2
    visBtn.BackgroundTransparency = 0.9
    visBtn.Text = "○"
    visBtn.TextColor3 = C.sub
    visBtn.TextTransparency = 0.4
    visBtn.TextSize = 11
    visBtn.Font = FONT_ICON
    visBtn.AutoButtonColor = false
    visBtn.BorderSizePixel = 0
    visBtn.ZIndex = 12
    visBtn.Parent = row
    Instance.new("UICorner", visBtn).CornerRadius = UDim.new(1, 0)

    local visStroke = Instance.new("UIStroke")
    visStroke.Color = C.border
    visStroke.Thickness = 1
    visStroke.Transparency = 0.9
    visStroke.Parent = visBtn

    -- Row-wide click (for long press)
    local click = Instance.new("TextButton")
    click.Size = UDim2.new(1, 0, 1, 0)
    click.BackgroundTransparency = 1
    click.Text = ""
    click.ZIndex = 11
    click.Parent = row

    local holdStart, holdTask, longPressed = nil, nil, false

    click.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            holdStart = tick()
            longPressed = false
            if holdTask then task.cancel(holdTask) end
            holdTask = task.delay(0.6, function()
                if holdStart then
                    longPressed = true
                    toggleFloating(featureId)
                end
            end)
        end
    end)

    click.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if not longPressed then
                Features.toggle(featureId)
            end
            holdStart = nil
            if holdTask then task.cancel(holdTask); holdTask = nil end
        end
    end)

    lockBtn.MouseButton1Click:Connect(function()
        f.locked = not f.locked
        if f.locked then
            lockBtn.Text = "●"
            TweenService:Create(lockBtn, TweenInfo.new(0.15), {TextColor3 = C.warn, BackgroundTransparency = 0.2}):Play()
            TweenService:Create(lockStroke, TweenInfo.new(0.15), {Color = C.warn, Transparency = 0.2}):Play()
        else
            lockBtn.Text = "○"
            TweenService:Create(lockBtn, TweenInfo.new(0.15), {TextColor3 = C.sub, BackgroundTransparency = 0.5}):Play()
            TweenService:Create(lockStroke, TweenInfo.new(0.15), {Color = C.border, Transparency = 0.7}):Play()
        end
        if f.refreshFloating then f.refreshFloating() end
    end)

    visBtn.MouseButton1Click:Connect(function()
        f.pillVisible = not f.pillVisible
        if f.pillVisible then
            visBtn.Text = "○"
            TweenService:Create(visBtn, TweenInfo.new(0.15), {TextColor3 = C.sub, TextTransparency = 0.4}):Play()
        else
            visBtn.Text = "●"
            TweenService:Create(visBtn, TweenInfo.new(0.15), {TextColor3 = C.warn, TextTransparency = 0.1}):Play()
        end
        if f.refreshFloating then f.refreshFloating() end
    end)
    visBtn.MouseEnter:Connect(function()
        TweenService:Create(visStroke, TweenInfo.new(0.15), {Transparency = 0.4}):Play()
    end)
    visBtn.MouseLeave:Connect(function()
        TweenService:Create(visStroke, TweenInfo.new(0.15), {Transparency = 0.9}):Play()
    end)

    return row
end

