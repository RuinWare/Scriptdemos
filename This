end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        if dragState then
            local delta = input.Position - dragState.startMouse
            dragState.target = Vector2.new(dragState.startPos.X + delta.X, dragState.startPos.Y + delta.Y)
        end
        if resizeState then
            local delta = input.Position - resizeState.startMouse
            local nx, ny = resizeState.startSize.X, resizeState.startSize.Y
            if resizeState.mode == "br" or resizeState.mode == "r" then nx = resizeState.startSize.X + delta.X end
            if resizeState.mode == "br" or resizeState.mode == "b" then ny = resizeState.startSize.Y + delta.Y end
            nx = math.clamp(nx, MIN_W, 1000)
            ny = math.clamp(ny, MIN_H, 800)
            win.Size = UDim2.fromOffset(nx, ny)
            shadow.Size = UDim2.fromOffset(nx, ny)
