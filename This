    iconBox.BackgroundTransparency = 0.4
    iconBox.BorderSizePixel = 0
    iconBox.ZIndex = 31
    iconBox.Parent = btn
    Instance.new("UICorner", iconBox).CornerRadius = UDim.new(1, 0)

    local iconStroke = Instance.new("UIStroke")
    iconStroke.Color = C.border
    iconStroke.Thickness = 1
    iconStroke.Transparency = 0.5
    iconStroke.Parent = iconBox

    local iconLbl = Instance.new("TextLabel")
    iconLbl.Size = UDim2.fromScale(1, 1)
    iconLbl.BackgroundTransparency = 1
    iconLbl.Text = f.icon
    iconLbl.TextColor3 = C.sub
    iconLbl.TextSize = 22
    iconLbl.Font = FONT_ICON
    iconLbl.ZIndex = 32
    iconLbl.Parent = iconBox

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size = UDim2.new(1, -54, 1, 0)
    nameLbl.Position = UDim2.new(0, 50, 0, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = f.name
    nameLbl.TextColor3 = C.sub
    nameLbl.TextSize = 12
    nameLbl.Font = FONT_BOLD
    nameLbl.TextXAlignment = Enum.TextXAlignment.Left
    nameLbl.TextYAlignment = Enum.TextYAlignment.Center
    nameLbl.ZIndex = 32
    nameLbl.Parent = btn

    f.floating = btn

    local function updateVisual()
        if not btn.Parent then return end
        if not f.pillVisible then
            btn.BackgroundTransparency = 1
            stroke.Transparency = 1
            iconBox.BackgroundTransparency = 1
            iconStroke.Transparency = 1
            iconLbl.TextTransparency = 1
            nameLbl.TextTransparency = 1
            return
        end
        btn.BackgroundTransparency = 0.2
        iconBox.BackgroundTransparency = 0.4
        iconLbl.TextTransparency = 0
        nameLbl.TextTransparency = 0
        if f.enabled then
            stroke.Color = f.locked and C.warn or C.aurora
            stroke.Transparency = 0.1
            nameLbl.TextColor3 = C.aurora
            iconLbl.TextColor3 = C.aurora
            iconStroke.Color = C.aurora
            iconStroke.Transparency = 0.3
            btn.BackgroundColor3 = C.glass
        else
            stroke.Color = f.locked and C.warn or C.border
            stroke.Transparency = 0.4
            nameLbl.TextColor3 = C.sub
            iconLbl.TextColor3 = C.sub
            iconStroke.Color = C.border
            iconStroke.Transparency = 0.5
            btn.BackgroundColor3 = C.space
        end
    end
    updateVisual()
    Features.addListener(featureId, updateVisual)
    f.refreshFloating = updateVisual

    local drag = nil
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            drag = {
                startMouse = input.Position,
                startPos = Vector2.new(btn.Position.X.Offset, btn.Position.Y.Offset),
                moved = false,
            }
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if drag and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - drag.startMouse
            if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then
                drag.moved = true
            end
            if not f.locked and f.pillVisible then
                btn.Position = UDim2.new(0.5, drag.startPos.X + delta.X, 0.5, drag.startPos.Y + delta.Y)
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if drag then
                if not drag.moved then
                    Features.toggle(featureId)
                elseif not f.locked and f.pillVisible then
                    f.hudOffset = Vector2.new(btn.Position.X.X.Offset or btn.Position.X.Offset, btn.Position.Y.Offset)
                    f.hudOffset = Vector2.new(btn.Position.X.Offset, btn.Position.Y.Offset)
                end
            end
            drag = nil
        end
    end)
end

