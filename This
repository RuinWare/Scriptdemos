    rowSub.TextColor3 = C.sub
    rowSub.TextSize = 9
    rowSub.Font = FONT_MONO
    rowSub.TextXAlignment = Enum.TextXAlignment.Left
    rowSub.ZIndex = 9
    rowSub.Parent = row

    -- iOS 26 liquid glass toggle
    local _, renderToggle = makeGlassToggle(
        row,
        UDim2.new(1, -8, 0, 16),
        function() return f.enabled end,
        function(v) Features.setEnabled(featureId, v) end
    )
    Features.addListener(featureId, function() renderToggle(true) end)

    -- Lock button
    local lockBtn = Instance.new("TextButton")
    lockBtn.Size = UDim2.fromOffset(24, 24)
    lockBtn.Position = UDim2.new(1, -114, 0, 17)
