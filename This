    rowIcon.BackgroundColor3 = C.panel2
    rowIcon.BackgroundTransparency = 0.3
    rowIcon.Text = f.icon
    rowIcon.TextColor3 = C.sub
    rowIcon.TextSize = 18
    rowIcon.Font = FONT_ICON
    rowIcon.ZIndex = 9
    rowIcon.Parent = row
    Instance.new("UICorner", rowIcon).CornerRadius = UDim.new(0, 8)

    local rowName = Instance.new("TextLabel")
    rowName.Size = UDim2.new(1, -220, 0, 18)
    rowName.Position = UDim2.new(0, 56, 0, 10)
    rowName.BackgroundTransparency = 1
    rowName.Text = f.name
    rowName.TextColor3 = C.text
    rowName.TextSize = 12
    rowName.Font = FONT_BOLD
    rowName.TextXAlignment = Enum.TextXAlignment.Left
    rowName.ZIndex = 9
    rowName.Parent = row

    local rowSub = Instance.new("TextLabel")
