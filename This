--  FEATURE REGISTRY
-- ═══════════════════════════════════════════════════════════════════
local Features = {}

function Features.register(id, opts)
    Features[id] = {
        id = id,
        name = opts.name or id,
        icon = opts.icon or "●",
        hint = opts.hint or "tap = toggle  ·  hold = pin to HUD",
        enabled = false,
        locked = false,
        pillVisible = true,
        hudOffset = opts.hudOffset or Vector2.new(-180, 200),
        listeners = {},
        onEnable = opts.onEnable,
        onDisable = opts.onDisable,
        floating = nil,
        refreshFloating = nil,
    }
    return Features[id]
end

function Features.setEnabled(id, state)
    local f = Features[id]
    if not f or f.enabled == state then return end
    f.enabled = state
    if state and f.onEnable then pcall(f.onEnable) end
    if not state and f.onDisable then pcall(f.onDisable) end
    for _, cb in ipairs(f.listeners) do pcall(cb, state) end
end

function Features.toggle(id)
    local f = Features[id]
    if not f then return end
    Features.setEnabled(id, not f.enabled)
end

function Features.addListener(id, cb)
    local f = Features[id]
    if f then table.insert(f.listeners, cb) end
end

