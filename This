--  AUTO JUMP
-- ═══════════════════════════════════════════════════════════════════
local MAX_SLOPE_DEG = 35
local MAX_SLOPE_COS = math.cos(math.rad(MAX_SLOPE_DEG))
local JUMP_COOLDOWN = 0.12

local jumpRayParams = RaycastParams.new()
jumpRayParams.FilterType = Enum.RaycastFilterType.Exclude
jumpRayParams.IgnoreWater = true

local lastJump = 0

local function worstGroundNormal(char, root)
    jumpRayParams.FilterDescendantsInstances = { char }

    local origin = Vector3.new(root.Position.X, root.Position.Y - 1.5, root.Position.Z)
    local offsets = {
        Vector3.new(0, 0, 0),
        Vector3.new(1.2, 0, 0),
        Vector3.new(-1.2, 0, 0),
        Vector3.new(0, 0, 1.2),
        Vector3.new(0, 0, -1.2),
    }

    local worstY = 1
    local got = false
    for _, off in ipairs(offsets) do
        local res = workspace:Raycast(origin + off, Vector3.new(0, -8, 0), jumpRayParams)
        if res then
            got = true
            if res.Normal.Y < worstY then
                worstY = res.Normal.Y
            end
        end
    end
    return got, worstY
end

RunService.Heartbeat:Connect(function()
    if not Features.autojump.enabled then return end

    local now = tick()
    if now - lastJump < JUMP_COOLDOWN then return end

    local char = player.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Jumping
    or state == Enum.HumanoidStateType.Freefall
    or state == Enum.HumanoidStateType.Landed then
        return
    end

    if hum.FloorMaterial == Enum.Material.Air then return end

    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local gotGround, worstY = worstGroundNormal(char, root)
    if gotGround and worstY < MAX_SLOPE_COS then
        return
    end

    pcall(function()
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end)
    lastJump = now
end)

-- ═══════════════════════════════════════════════════════════════════
--  ASSET LOADER
-- ═══════════════════════════════════════════════════════════════════
local SURFACE_FIELDS = {
    "TopSurface","BottomSurface",
    "LeftSurface","RightSurface",
    "FrontSurface","BackSurface",
}

local function stripScripts(root)
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
            pcall(function() d:Destroy() end)
        end
    end
end

local function smoothSurfaces(root)
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("BasePart") then
            for _, f in ipairs(SURFACE_FIELDS) do
                pcall(function() d[f] = Enum.SurfaceType.Smooth end)
            end
        end
    end
end

local function loadAssetById(id)
    local ok, objs = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(id))
    end)
    if not ok or not objs or #objs == 0 then return nil, "GetObjects failed" end
    local root = objs[1]
    if not root then return nil, "empty asset" end
    if Config.get("strip_scripts") then stripScripts(root) end
    if Config.get("auto_smooth") then smoothSurfaces(root) end
    return root
end

local function findChildCI(parent, name)
    for _, c in ipairs(parent:GetChildren()) do
        if c.Name:lower() == name:lower() then return c end
    end
    return nil
end

local function getInnerMapFolder()
    local map = workspace:FindFirstChild("Map") or findChildCI(workspace, "map")
    if not map then return nil, "workspace.Map not found" end

    local parts = findChildCI(map, "parts")
    if parts then
        local inner = findChildCI(parts, "map")
        if inner then return inner end
        return parts
    end

    local inner2 = findChildCI(map, "map")
    if inner2 then return inner2 end

    return map
end

local function clearSpawnLocations(container)
    for _, d in ipairs(container:GetDescendants()) do
        if d:IsA("SpawnLocation") then
            pcall(function() d:Destroy() end)
        end
    end
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("SpawnLocation") then
            local insideChar = false
            local char = player.Character
            if char and d:IsDescendantOf(char) then insideChar = true end
            if not insideChar then
                pcall(function() d:Destroy() end)
            end
        end
    end
end

local function clearTerrain()
    pcall(function() workspace.Terrain:Clear() end)
end

local function findSpawnInAsset(asset)
    for _, d in ipairs(asset:GetDescendants()) do
        if d:IsA("SpawnLocation") then return d end
    end
    return nil
end

local function replaceMap(asset)
    local inner, err = getInnerMapFolder()
    if not inner then return false, err end

    if Config.get("clear_spawns") then clearSpawnLocations(inner) end
    if Config.get("clear_terrain") then clearTerrain() end

    for _, child in ipairs(inner:GetChildren()) do
        pcall(function() child:Destroy() end)
    end

    asset.Parent = inner
    return true, inner
end

local function getPivot(asset)
    if asset:IsA("Model") then
        local ok, cf = pcall(function() return asset:GetPivot() end)
        if ok then return cf end
        local ok2, box = pcall(function() return asset:GetBoundingBox() end)
        if ok2 then return box end
    elseif asset:IsA("BasePart") then
        return asset.CFrame
    elseif asset:IsA("Folder") then
        for _, d in ipairs(asset:GetDescendants()) do
            if d:IsA("BasePart") then return d.CFrame end
        end
    end
    return CFrame.new(0, 0, 0)
end

local function getCharacter()
    local char = player.Character
    if not char or not char.Parent then
        char = player.CharacterAdded:Wait()
    end
    return char
end

local function giveForceField(char, dur)
    local ff = Instance.new("ForceField")
    ff.Visible = false
    ff.Parent = char
    task.delay(dur or 8, function()
        if ff and ff.Parent then ff:Destroy() end
    end)
end

local function teleportToSpawn(asset)
    local spawnPart = findSpawnInAsset(asset)
    if spawnPart and Config.get("use_asset_spawn") then
        local char = getCharacter()
        local target = spawnPart.Position + Vector3.new(0, 4, 0)
        pcall(function() char:PivotTo(CFrame.new(target)) end)
        giveForceField(char, 3)
        return "asset spawn"
    end

    local char = getCharacter()
    local pivot = getPivot(asset)
    pcall(function() char:PivotTo(CFrame.new(pivot.Position + Vector3.new(0, 100, 0))) end)
    giveForceField(char, 8)
    return "100 studs above"
end

activateBtn.MouseButton1Click:Connect(function()
    local id = tonumber((idBox.Text:gsub("%s+", "")))
    if not id then
        setStatus("invalid asset id", C.bad)
