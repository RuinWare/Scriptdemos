--  LADDER GLIDE (4000 studs)
-- ═══════════════════════════════════════════════════════════════════
local ladderGlideTask = nil
local ladderGlideOrigin = nil
local ladderWarningGui = nil

local function startLadderGlide()
    if ladderGlideTask then return end
    local char = player.Character
    if not char then
        setStatus("no character", C.bad, 1.5)
        return
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        setStatus("no root part", C.bad, 1.5)
        return
    end

    ladderGlideOrigin = root.CFrame
    setStatus("ladder glide ON", C.good, 2)

    ladderGlideTask = task.spawn(function()
        while Features.ladderglide and Features.ladderglide.enabled do
            local c = player.Character
            if not c then break end
            local r = c:FindFirstChild("HumanoidRootPart")
            if not r then break end
            if not ladderGlideOrigin then break end

            local rightCF = CFrame.new(ladderGlideOrigin.Position + Vector3.new(4000, 0, 0))
            pcall(function() c:PivotTo(rightCF) end)

            local waited = 0
            while waited < 7 do
                if not Features.ladderglide or not Features.ladderglide.enabled then break end
                task.wait(0.1)
                waited += 0.1
            end

            if not Features.ladderglide or not Features.ladderglide.enabled then break end

            pcall(function() c:PivotTo(ladderGlideOrigin) end)
            task.wait(0.4)
        end
        ladderGlideTask = nil
    end)
end

local function stopLadderGlide()
    if ladderGlideTask then
        pcall(task.cancel, ladderGlideTask)
        ladderGlideTask = nil
    end
    if ladderGlideOrigin then
        local char = player.Character
        if char then
            pcall(function() char:PivotTo(ladderGlideOrigin) end)
        end
        ladderGlideOrigin = nil
    end
    setStatus("ladder glide off", C.sub, 1.5)
end

