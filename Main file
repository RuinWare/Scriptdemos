    g:SetAttribute("GlowOffset", offset)
    table.insert(glowLayers, g)
    task.spawn(function()
        local base = alpha
        local peak = math.max(0.5, alpha - 0.25)
        while g.Parent do
            TweenService:Create(g, TweenInfo.new(period, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundTransparency = peak}):Play()
