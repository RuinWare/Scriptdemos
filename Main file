local function toggleFloating(featureId)
    local f = Features[featureId]
    if not f then return end

    if f.floating and f.floating.Parent then
        f.floating:Destroy()
        f.floating = nil
        f.refreshFloating = nil
        return
    end

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(138, 58)
    btn.Position = UDim2.new(0.5, f.hudOffset.X, 0.5, f.hudOffset.Y)
    btn.BackgroundColor3 = C.space
    btn.BackgroundTransparency = 0.25
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.BorderSizePixel = 0
    btn.ZIndex = 30
    btn.ClipsDescendants = true
    btn.Parent = guiHud
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

    local btnScale = Instance.new("UIScale")
    btnScale.Scale = 1
    btnScale.Parent = btn

    local particleLayer = Instance.new("Frame")
    particleLayer.Size = UDim2.fromScale(1, 1)
    particleLayer.BackgroundTransparency = 1
    particleLayer.ClipsDescendants = true
    particleLayer.ZIndex = 30
    particleLayer.Parent = btn
    for i = 1, 10 do
        local p = Instance.new("Frame")
        p.Size = UDim2.fromOffset(1, 1)
        p.BackgroundColor3 = C.star
        p.BackgroundTransparency = 0.3 + math.random() * 0.5
        p.BorderSizePixel = 0
        p.Position = UDim2.new(math.random(), 0, math.random(), 0)
        p.ZIndex = 31
        p.Parent = particleLayer
        Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)
    end
    task.spawn(function()
        while btn.Parent do
            task.wait(0.04)
            for _, p in ipairs(particleLayer:GetChildren()) do
                if p:IsA("Frame") then
                    local nx = (p.Position.X.Scale + 0.006) % 1.02 - 0.01
                    p.Position = UDim2.new(nx, 0, p.Position.Y.Scale, 0)
                end
            end
        end
    end)

    local btnGrad = Instance.new("UIGradient")
    btnGrad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(28, 34, 54)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(8, 10, 22)),
    }
    btnGrad.Rotation = 90
    btnGrad.Parent = btn

    local glassHi = Instance.new("Frame")
    glassHi.Size = UDim2.new(1, -8, 0.35, 0)
    glassHi.Position = UDim2.new(0, 4, 0, 3)
    glassHi.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    glassHi.BackgroundTransparency = 0.92
    glassHi.BorderSizePixel = 0
    glassHi.ZIndex = 31
    glassHi.Parent = btn
    Instance.new("UICorner", glassHi).CornerRadius = UDim.new(1, 0)

    local stroke = Instance.new("UIStroke")
    stroke.Color = C.border
    stroke.Thickness = 1.6
    stroke.Transparency = 0.3
    stroke.Parent = btn

    local iconImg = Instance.new("ImageLabel")
    iconImg.Size = UDim2.fromOffset(38, 38)
    iconImg.Position = UDim2.new(0, 10, 0.5, -19)
    iconImg.BackgroundColor3 = C.panel2
    iconImg.BackgroundTransparency = 0.4
    iconImg.Image = LOGO_ID
    iconImg.ImageColor3 = Color3.fromRGB(255, 255, 255)
    iconImg.ScaleType = Enum.ScaleType.Fit
    iconImg.ZIndex = 32
    iconImg.Parent = btn
    Instance.new("UICorner", iconImg).CornerRadius = UDim.new(1, 0)

    local iconStroke = Instance.new("UIStroke")
    iconStroke.Color = C.border
    iconStroke.Thickness = 1
    iconStroke.Transparency = 0.5
    iconStroke.Parent = iconImg

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size = UDim2.new(1, -58, 0, 16)
    nameLbl.Position = UDim2.new(0, 54, 0, 12)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = f.name
    nameLbl.TextColor3 = C.sub
    nameLbl.TextSize = 12
    nameLbl.Font = FONT_BOLD
    nameLbl.TextXAlignment = Enum.TextXAlignment.Left
    nameLbl.ZIndex = 32
    nameLbl.Parent = btn

    local catLbl = Instance.new("TextLabel")
    catLbl.Size = UDim2.new(1, -58, 0, 12)
    catLbl.Position = UDim2.new(0, 54, 0, 30)
    catLbl.BackgroundTransparency = 1
    catLbl.Text = f.category:lower()
    catLbl.TextColor3 = C.sub
    catLbl.TextSize = 9
    catLbl.Font = FONT_MONO
    catLbl.TextXAlignment = Enum.TextXAlignment.Left
    catLbl.ZIndex = 32
    catLbl.Parent = btn

    f.floating = btn

    local function updateVisual()
        if not btn.Parent then return end
        if not f.pillVisible then
            btn.BackgroundTransparency = 1
            stroke.Transparency = 1
            iconImg.BackgroundTransparency = 1
            iconImg.ImageTransparency = 1
            iconStroke.Transparency = 1
            glassHi.BackgroundTransparency = 1
            nameLbl.TextTransparency = 1
            catLbl.TextTransparency = 1
            for _, p in ipairs(particleLayer:GetChildren()) do
                if p:IsA("Frame") then p.BackgroundTransparency = 1 end
            end
            return
        end
        btn.BackgroundTransparency = 0.25
        iconImg.BackgroundTransparency = 0.4
        iconImg.ImageTransparency = 0
        glassHi.BackgroundTransparency = 0.92
        nameLbl.TextTransparency = 0
        catLbl.TextTransparency = 0
        for _, p in ipairs(particleLayer:GetChildren()) do
            if p:IsA("Frame") then p.BackgroundTransparency = 0.3 + math.random() * 0.5 end
        end
        if f.isButton or f.enabled then
            stroke.Color = f.locked and C.warn or C.aurora
            stroke.Transparency = 0.1
            nameLbl.TextColor3 = C.aurora
            iconStroke.Color = C.aurora
            iconStroke.Transparency = 0.3
        else
            stroke.Color = f.locked and C.warn or C.border
            stroke.Transparency = 0.35
            nameLbl.TextColor3 = C.sub
            iconStroke.Color = C.border
            iconStroke.Transparency = 0.5
        end
    end
    updateVisual()
    Features.addListener(featureId, updateVisual)
    f.refreshFloating = updateVisual

    btnScale.Scale = 0.5
    TweenService:Create(btnScale, TweenInfo.new(0.3, Enum.EasingStyle.Back), {Scale = 1}):Play()

    local drag = nil
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if drag then return end
            drag = {
                sourceInput = input,
                isTouch = (input.UserInputType == Enum.UserInputType.Touch),
                startMouse = input.Position,
                startPos = Vector2.new(btn.Position.X.Offset, btn.Position.Y.Offset),
                startTime = tick(),
                moved = false,
            }
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not drag then return end
        local matches
        if drag.isTouch then
            matches = (input == drag.sourceInput)
        else
            matches = (input.UserInputType == Enum.UserInputType.MouseMovement)
        end
        if not matches then return end

        local delta = input.Position - drag.startMouse
        if math.abs(delta.X) > 10 or math.abs(delta.Y) > 10 then
            drag.moved = true
        end
        if not f.locked and f.pillVisible and drag.moved then
            btn.Position = UDim2.new(0.5, drag.startPos.X + delta.X, 0.5, drag.startPos.Y + delta.Y)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if not drag then return end
        local matches
        if drag.isTouch then
            matches = (input == drag.sourceInput)
        else
            matches = (input.UserInputType == Enum.UserInputType.MouseButton1)
        end
        if not matches then return end

        local held = tick() - drag.startTime
        if not drag.moved and held < 0.35 then
            if f.isButton then
                if f.action then pcall(f.action) end
            else
                Features.toggle(featureId)
            end
        elseif drag.moved and not f.locked and f.pillVisible then
            f.hudOffset = Vector2.new(btn.Position.X.Offset, btn.Position.Y.Offset)
        end
        drag = nil
    end)
end

