local espActive = {}     -- [plr] = { highlight, billboard, tracer }
local espMasterOn = false

local function clearESPFor(plr)
    local e = espActive[plr]
    if not e then return end
    if e.highlight then e.highlight:Destroy() end
    if e.box then e.box:Destroy() end
    if e.billboard then e.billboard:Destroy() end
    if e.tracer then e.tracer:Destroy() end
    espActive[plr] = nil
end

local function clearAllESP()
    for plr in pairs(espActive) do
        clearESPFor(plr)
    end
end

local function buildESPFor(plr)
    if plr == player then return end
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    clearESPFor(plr)
    local e = {}

    -- Highlight
    if Config.get("esp_highlight") then
        local hl = Instance.new("Highlight")
        hl.Name = "ReforgedESP"
        hl.Adornee = char
        hl.FillColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.65
        hl.OutlineColor = Color3.fromRGB(0, 0, 0)
        hl.OutlineTransparency = 0.1
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = guiMain
        e.highlight = hl
    end

    -- Box (SelectionBox around the HRP)
    if Config.get("esp_box") then
        local box = Instance.new("SelectionBox")
        box.Name = "ReforgedESPBox"
        box.Adornee = hrp
        box.Color3 = Color3.fromRGB(255, 255, 255)
        box.LineThickness = 0.05
        box.SurfaceTransparency = 1
        box.SurfaceColor3 = Color3.fromRGB(255, 255, 255)
        box.Parent = guiMain
        e.box = box
    end

    -- Distance / Name billboard
    if Config.get("esp_distance") then
        local bb = Instance.new("BillboardGui")
        bb.Name = "ReforgedESPDist"
        bb.Adornee = hrp
        bb.Size = UDim2.fromOffset(120, 20)
        bb.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        bb.Parent = guiMain

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.fromScale(1, 1)
        lbl.BackgroundTransparency = 1
        lbl.Text = plr.Name
        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        lbl.TextSize = 12
        lbl.Font = FONT_BOLD
        lbl.TextStrokeTransparency = 0
        lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        lbl.Parent = bb
        e.billboard = bb
        e.billboardLabel = lbl
    end

    -- Tracer (line from bottom of screen)
    if Config.get("esp_tracers") then
        local tr = Instance.new("Frame")
        tr.Name = "ReforgedESPTracer"
        tr.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        tr.BorderSizePixel = 0
        tr.AnchorPoint = Vector2.new(0, 0.5)
        tr.ZIndex = 50
        tr.Parent = guiMain
        e.tracer = tr
        e.tracerOrigin = Vector2.new(workspace.CurrentCamera.ViewportSize.X / 2,
                                      workspace.CurrentCamera.ViewportSize.Y)
    end

    espActive[plr] = e
end

local function refreshAllESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            if espMasterOn and plr.Character then
                buildESPFor(plr)
            else
                clearESPFor(plr)
            end
        end
    end
end

-- ESP render loop for tracers + distance
RunService.RenderStepped:Connect(function()
    if not espMasterOn then
        if next(espActive) then clearAllESP() end
        return
    end

    local cam = workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize
    local origin = Vector2.new(vp.X / 2, vp.Y)

    for plr, e in pairs(espActive) do
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            clearESPFor(plr)
            continue
        end

        -- Distance update
        if e.billboardLabel then
            local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local dist = (myRoot.Position - hrp.Position).Magnitude
                e.billboardLabel.Text = string.format("%s  [%d]", plr.Name, math.floor(dist))
            end
        end

        -- Tracer update
        if e.tracer then
            local sp, onScreen = cam:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local target = Vector2.new(sp.X, sp.Y)
                local diff = target - origin
                local length = diff.Magnitude
                local mid = (origin + target) / 2
                local angle = math.atan2(diff.Y, diff.X)
                e.tracer.Size = UDim2.fromOffset(length, 1)
                e.tracer.Position = UDim2.fromOffset(mid.X, mid.Y)
                e.tracer.Rotation = math.deg(angle)
                e.tracer.Visible = true
            else
                e.tracer.Visible = false
            end
        end
    end
end)

-- Player add/remove listeners
local function espPlayerAdded(plr)
    if plr == player then return end
    if espMasterOn then
        plr.CharacterAdded:Connect(function()
            task.wait(0.3)
            if espMasterOn then buildESPFor(plr) end
        end)
        if plr.Character then
            task.wait(0.3)
            if espMasterOn then buildESPFor(plr) end
        end
    end
end

Players.PlayerAdded:Connect(function(plr)
    if espMasterOn then espPlayerAdded(plr) end
end)

Players.PlayerRemoving:Connect(function(plr)
    clearESPFor(plr)
end)

