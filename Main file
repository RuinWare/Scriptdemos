-- ═══════════════════════════════════════════════════════════════════
--  AUTO JUMP + FRONTAL / BACKWARD JUMP
-- ═══════════════════════════════════════════════════════════════════
local MAX_SLOPE_COS = math.cos(math.rad(35))
local lastJump = 0
local lastJumpShown = 0
local JUMP_COOLDOWN = 0.02

local jumpRayParams = RaycastParams.new()
jumpRayParams.FilterType = Enum.RaycastFilterType.Exclude
jumpRayParams.IgnoreWater = true

local function worstGroundNormal(char, root)
    jumpRayParams.FilterDescendantsInstances = { char }
    local origin = Vector3.new(root.Position.X, root.Position.Y - 1.5, root.Position.Z)
    local offsets = {
        Vector3.new(0, 0, 0),
        Vector3.new(1.2, 0, 0),
        Vector3.new(-1.2, 0, 0),
        Vector3.new(0, 0, 1.2),
        Vector3.new(0, 0, -1.2),
    }
    local worstY = 1
    local got = false
    for _, off in ipairs(offsets) do
        local res = workspace:Raycast(origin + off, Vector3.new(0, -8, 0), jumpRayParams)
        if res then
            got = true
            if res.Normal.Y < worstY then worstY = res.Normal.Y end
        end
    end
    return got, worstY
end

-- ── Continual push for frontal/backward jump ─────────────────────
RunService.Heartbeat:Connect(function()
    local isFrontal  = Features.frontaljump  and Features.frontaljump.enabled
    local isBackward = Features.backwardjump and Features.backwardjump.enabled
    if not (isFrontal or isBackward) then return end

    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local speed = Config.get("frontal_speed") or 50
    local dir = isFrontal and 1 or -1
    local look = root.CFrame.LookVector
    -- Constant horizontal velocity in look direction
    local horizontal = Vector3.new(look.X, 0, look.Z).Unit * speed * dir
    root.AssemblyLinearVelocity = Vector3.new(
        horizontal.X,
        root.AssemblyLinearVelocity.Y,
        horizontal.Z
    )
end)

-- ── The actual jump logic ────────────────────────────────────────
RunService.Stepped:Connect(function()
    local ajOn     = Features.autojump     and Features.autojump.enabled
    local frontOn  = Features.frontaljump  and Features.frontaljump.enabled
    local backOn   = Features.backwardjump and Features.backwardjump.enabled
    local trimpOn  = Features.autotrimp    and Features.autotrimp.enabled
    if not (ajOn or frontOn or backOn or trimpOn) then return end

    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if hum.FloorMaterial == Enum.Material.Air then return end
    local st = hum:GetState()
    if st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall then return end
    local now = tick()
    if now - lastJump < JUMP_COOLDOWN then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local gotGround, worstY = worstGroundNormal(char, root)
    if gotGround and worstY < MAX_SLOPE_COS then return end
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
    lastJump = now
    if now - lastJumpShown > 0.6 then
        lastJumpShown = now
        setStatus("auto jump active", C.good, 1.0)
    end
end)

-- ═══════════════════════════════════════════════════════════════════
--  EASY + HARD BOUNCE + E-FLING
-- ═══════════════════════════════════════════════════════════════════
local airStartTick = 0
local wasAirborne = false
local MIN_AIR = 1.5
local MIN_SLOPE_COS_BOUNCE = math.cos(math.rad(10))
local lastYVel = 0

local bounceRayParams = RaycastParams.new()
bounceRayParams.FilterType = Enum.RaycastFilterType.Exclude
bounceRayParams.IgnoreWater = true

local function getGroundNormal(char, root)
    bounceRayParams.FilterDescendantsInstances = { char }
    local origin = Vector3.new(root.Position.X, root.Position.Y - 1.5, root.Position.Z)
    local res = workspace:Raycast(origin, Vector3.new(0, -6, 0), bounceRayParams)
    if res then return res.Normal end
    return nil
end

RunService.Heartbeat:Connect(function()
    local easyOn  = Features.easybounce and Features.easybounce.enabled
    local hardOn  = Features.hardbounce and Features.hardbounce.enabled
    local trimpOn = Features.autotrimp and Features.autotrimp.enabled
    local flingOn = Features.efling and Features.efling.enabled
    local anyBounce = easyOn or hardOn or trimpOn or flingOn

    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local airborne = hum.FloorMaterial == Enum.Material.Air

    if airborne then
        lastYVel = root.AssemblyLinearVelocity.Y
    end

    if airborne and not wasAirborne then
        wasAirborne = true
        airStartTick = tick()
    elseif not airborne and wasAirborne then
        local airtime = tick() - airStartTick
        wasAirborne = false

        if anyBounce then
            local reqAir = flingOn and 0.2 or MIN_AIR

            if airtime >= reqAir then
                local normal = getGroundNormal(char, root)
                if normal then
                    local isRamp = normal.Y <= MIN_SLOPE_COS_BOUNCE
                    local shouldFire = false

                    if flingOn then
                        shouldFire = isRamp
                    elseif hardOn then
                        shouldFire = true
                    elseif easyOn or trimpOn then
                        shouldFire = isRamp
                    end

                    if shouldFire then
                        local fall = math.abs(lastYVel)
                        if fall > 8 then
                            local mult = flingOn and 5.0 or (Config.get("bounce_multiplier") or 1.6)
                            local bounceSpeed = fall * (mult - 1) + 15
                            bounceSpeed = math.clamp(bounceSpeed, 20, 220)
                            root.AssemblyLinearVelocity = Vector3.new(
                                root.AssemblyLinearVelocity.X,
                                bounceSpeed,
                                root.AssemblyLinearVelocity.Z
                            )
                            local label = flingOn and "e-fling" or "bounce"
                            setStatus(string.format("%s  ·  %.0f", label, bounceSpeed), C.warn, 1.2)
                        end
                    end
                end
            end
        end
    end
end)

