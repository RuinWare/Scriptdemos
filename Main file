local spoofState = {
    username = "",
    display  = "",
}

local function applySpooferHooks()
    pcall(function()
        local mt = getrawmetatable(game)
        local oldIndex = mt.__index
        setreadonly(mt, false)
        mt.__index = newcclosure(function(self, key)
            if self == player then
                if key == "Name" and spoofState.username ~= "" then
                    return spoofState.username
                elseif key == "DisplayName" and spoofState.display ~= "" then
                    return spoofState.display
                end
            end
            return oldIndex(self, key)
        end)
        setreadonly(mt, true)
    end)
end
applySpooferHooks()

local function copyAvatarFromUsername(username)
    task.spawn(function()
        local ok, userId = pcall(function()
            return Players:GetUserIdFromUsername(username)
        end)
        if not ok or not userId or userId == 0 then return end
        local ok2, desc = pcall(function()
            return Players:GetHumanoidDescriptionFromUserId(userId)
        end)
        if not ok2 or not desc then return end
        local char = player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        pcall(function()
            hum:ApplyDescription(desc)
        end)
    end)
end

