        nm.TextColor3 = C.text
        nm.TextSize = 11
        nm.Font = FONT_MONO
        nm.TextXAlignment = Enum.TextXAlignment.Left
        nm.ZIndex = 10
        nm.Parent = item
        nm.MouseButton1Click:Connect(function()
            for k, v in pairs(p.data) do
                if Config.defaults[k] ~= nil then
                    Config.set(k, v)
                end
            end
            for _, cb in pairs(configCallbacks) do pcall(cb) end
            if refreshBounceSlider then pcall(refreshBounceSlider) end
            if refreshLagSlider then pcall(refreshLagSlider) end
            if refreshHipSlider then pcall(refreshHipSlider) end
            if refreshSpeedSlider then pcall(refreshSpeedSlider) end
            setStatus("loaded config: " .. p.name, C.good, 1.5)
        end)

        local del = Instance.new("TextButton")
        del.Size = UDim2.fromOffset(24, 24)
        del.AnchorPoint = Vector2.new(1, 0.5)
        del.Position = UDim2.new(1, -5, 0.5, 0)
