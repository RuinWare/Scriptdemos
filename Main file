                pt.y = pt.y - pt.speed * dt
                local x = pt.x + math.sin(t * 0.6 + pt.phase) * pt.sway + pt.drift * dt
                if pt.y < -0.05 then
                    pt.y = 1.05 + math.random() * 0.2
                    pt.x = math.random()
                end
                pt.el.Position = UDim2.new(x, 0, pt.y, 0)
