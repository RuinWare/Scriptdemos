function Features.register(id, opts)
    Features[id] = {
        id = id,
        name = opts.name or id,
        icon = opts.icon or "●",
        category = opts.category or "MOVEMENT",
        tab = opts.tab or "movement",
        hint = opts.hint or "tap = toggle  ·  hold = pin to HUD",
        enabled = false,
        locked = false,
        pillVisible = true,
        hudOffset = opts.hudOffset or Vector2.new(-180, 200),
        listeners = {},
        isButton = opts.isButton or false,
        action = opts.action,
    }
    return Features[id]
end

local FORCE_OFF = {
    autojump     = { "autotrimp", "frontaljump", "backwardjump" },
    easybounce   = { "hardbounce", "autotrimp", "efling" },
    hardbounce   = { "easybounce", "autotrimp", "efling" },
    autotrimp    = { "autojump", "easybounce", "hardbounce", "efling", "frontaljump", "backwardjump" },
    efling       = { "autojump", "easybounce", "hardbounce", "autotrimp" },
    frontaljump  = { "backwardjump", "autojump", "autotrimp" },
    backwardjump = { "frontaljump", "autojump", "autotrimp" },
}

function Features.setEnabled(id, state)
    local f = Features[id]
    if not f or f.enabled == state then return end
    f.enabled = state
    if state then
        local block = FORCE_OFF[id]
        if block then
            for _, otherId in ipairs(block) do
                if Features[otherId] and Features[otherId].enabled then
                    Features.setEnabled(otherId, false)
                end
            end
        end
    end
    for _, cb in ipairs(f.listeners) do pcall(cb, state) end
end

function Features.toggle(id)
    local f = Features[id]
    if not f then return end
    Features.setEnabled(id, not f.enabled)
end

function Features.addListener(id, cb)
    local f = Features[id]
    if f then table.insert(f.listeners, cb) end
end

