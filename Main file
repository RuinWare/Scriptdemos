-- ═══════════════════════════════════════════════════════════════════
--  RESPAWN HANDLING  ·  4-second delay, then teleport + camera rebind
-- ═══════════════════════════════════════════════════════════════════
local loadedMapInfo = nil

local function getMapTargetCF()
    if not loadedMapInfo then return nil end
    if loadedMapInfo.spawnPart and loadedMapInfo.spawnPart.Parent and Config.get("use_asset_spawn") then
        return CFrame.new(loadedMapInfo.spawnPart.Position + Vector3.new(0, 4, 0))
    else
        return CFrame.new(loadedMapInfo.pivot.Position + Vector3.new(0, 100, 0))
    end
end

local function teleportCharToMap(char)
    if not loadedMapInfo then return end
    local targetCF = getMapTargetCF()
    if not targetCF then return end

    task.spawn(function()
        -- Let the game fully finish its own spawn sequence first
        task.wait(4.0)

        local hum  = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root then return end

        -- Reset any stuck states from the respawn
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        pcall(function() hum.PlatformStand = false end)

        -- Hammer the position for 2s
        local endTime = tick() + 2.0
        while tick() < endTime do
            if not char or not char.Parent then return end
            local r = char:FindFirstChild("HumanoidRootPart")
            if r then
                r.CFrame = targetCF
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
            end
            task.wait()
        end

        -- Final snap + camera rebind
        local finalRoot = char:FindFirstChild("HumanoidRootPart")
        if finalRoot then
            finalRoot.CFrame = targetCF
            finalRoot.AssemblyLinearVelocity = Vector3.zero
        end
        pcall(function() char:PivotTo(targetCF) end)
        applyHipHeight()

        local cam = workspace.CurrentCamera
        if cam and hum then
            pcall(function() cam.CameraType = Enum.CameraType.Custom end)
            pcall(function() cam.CameraSubject = hum end)
        end

        -- ForceField for the fall
        local ff = Instance.new("ForceField")
        ff.Visible = false
        ff.Parent = char
        task.delay(8, function()
            if ff and ff.Parent then ff:Destroy() end
        end)
    end)
end

player.CharacterAdded:Connect(function(char)
    task.wait(0.1)
    teleportCharToMap(char)
end)

if player.Character then
    task.spawn(function()
        task.wait(4.0)
        teleportCharToMap(player.Character)
    end)
end

-- ═══════════════════════════════════════════════════════════════════
--  ASSET LOADER / MAP REPLACEMENT
-- ═══════════════════════════════════════════════════════════════════
local SURFACE_FIELDS = {
    "TopSurface","BottomSurface","LeftSurface","RightSurface","FrontSurface","BackSurface",
}

local function stripScripts(root)
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
            pcall(function() d:Destroy() end)
        end
    end
end

local function smoothSurfaces(root)
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("BasePart") then
            for _, f in ipairs(SURFACE_FIELDS) do
                pcall(function() d[f] = Enum.SurfaceType.Smooth end)
            end
        end
    end
end

local function loadAssetById(id)
    local ok, objs = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(id))
    end)
    if not ok or not objs or #objs == 0 then return nil, "GetObjects failed" end
    local root = objs[1]
    if not root then return nil, "empty asset" end
    if Config.get("strip_scripts") then stripScripts(root) end
    if Config.get("auto_smooth") then smoothSurfaces(root) end
    return root
end

local function findChildCI(parent, name)
    for _, c in ipairs(parent:GetChildren()) do
        if c.Name:lower() == name:lower() then return c end
    end
    return nil
end

local function getInnerMapFolder()
    local map = workspace:FindFirstChild("Map") or findChildCI(workspace, "map")
    if not map then return nil, "workspace.Map not found" end
    local parts = findChildCI(map, "parts")
    if parts then
        local inner = findChildCI(parts, "map")
        if inner then return inner end
        return parts
    end
    local inner2 = findChildCI(map, "map")
    if inner2 then return inner2 end
    return map
end

local function clearSpawnLocations(container)
    for _, d in ipairs(container:GetDescendants()) do
        if d:IsA("SpawnLocation") then pcall(function() d:Destroy() end) end
    end
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("SpawnLocation") then
            local insideChar = false
            local char = player.Character
            if char and d:IsDescendantOf(char) then insideChar = true end
            if not insideChar then pcall(function() d:Destroy() end) end
        end
    end
end

local function clearTerrain()
    pcall(function() workspace.Terrain:Clear() end)
end

local function clearExtraMapPaths()
    local map = workspace:FindFirstChild("Map") or findChildCI(workspace, "map")
    if not map then return end

    local function killPath(root, names)
        local current = root
        for _, name in ipairs(names) do
            if not current then return end
            current = findChildCI(current, name)
        end
        if current then
            pcall(function() current:Destroy() end)
        end
    end

    killPath(map, { "Parts", "Map", "Model" })
    killPath(map, { "InvisParts" })
    killPath(map, { "Parts", "Interactables" })
    killPath(map, { "Parts", "Water" })
    killPath(map, { "Parts", "Props" })
    killPath(map, { "Parts", "ImmovableProps" })
end

local function findSpawnInAsset(asset)
    for _, d in ipairs(asset:GetDescendants()) do
        if d:IsA("SpawnLocation") then return d end
    end
    return nil
end

local function getPivot(asset)
    if asset:IsA("Model") then
        local ok, cf = pcall(function() return asset:GetPivot() end)
        if ok then return cf end
        local ok2, box = pcall(function() return asset:GetBoundingBox() end)
        if ok2 then return box end
    elseif asset:IsA("BasePart") then
        return asset.CFrame
    elseif asset:IsA("Folder") then
        for _, d in ipairs(asset:GetDescendants()) do
            if d:IsA("BasePart") then return d.CFrame end
        end
    end
    return CFrame.new(0, 0, 0)
end

local function replaceMap(asset)
    local inner, err = getInnerMapFolder()
    if not inner then return false, err end
    if Config.get("clear_spawns") then clearSpawnLocations(inner) end
    if Config.get("clear_terrain") then clearTerrain() end
    clearExtraMapPaths()
    for _, child in ipairs(inner:GetChildren()) do
        pcall(function() child:Destroy() end)
    end
    asset.Parent = inner
    return true, inner
end

