local function hoverify(btn, stroke, hoverColor)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.1, TextColor3 = hoverColor}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Transparency = 0.1, Color = hoverColor}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.4, TextColor3 = C.sub}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Transparency = 0.55, Color = C.border}):Play()
    end)
end
