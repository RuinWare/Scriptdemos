task.spawn(function()
    local t = 0
    while starField.Parent do
        local dt = task.wait(0.03)
        t += dt
        for _, st in ipairs(stars) do
            if not st.el.Parent then continue end
            local nx = (st.baseX + t * st.speed) % 1.05 - 0.02
            local ny = st.baseY + math.sin(t * 0.4 + st.phase) * st.sway
            st.el.Position = UDim2.new(nx, 0, ny, 0)
        end
        for _, st in ipairs(stars) do
            if st.twinkle and math.random() < 0.02 then
                local target = 0.15 + math.random() * 0.75
                TweenService:Create(st.el, TweenInfo.new(0.9 + math.random() * 0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                    BackgroundTransparency = target
                }):Play()
            end
        end
    end
end)

