-- ═══════════════════════════════════════════════════════════════════
--  ASSET LOADER
-- ═══════════════════════════════════════════════════════════════════
local SURFACE_FIELDS = {
    "TopSurface","BottomSurface",
    "LeftSurface","RightSurface",
    "FrontSurface","BackSurface",
}

local function stripScripts(root)
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
            pcall(function() d:Destroy() end)
        end
    end
end

local function smoothSurfaces(root)
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("BasePart") then
            for _, f in ipairs(SURFACE_FIELDS) do
                pcall(function() d[f] = Enum.SurfaceType.Smooth end)
            end
        end
    end
end

local function loadAssetById(id)
    local ok, objs = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(id))
    end)
    if not ok or not objs or #objs == 0 then return nil, "GetObjects failed" end
    local root = objs[1]
    if not root then return nil, "empty asset" end
    if Config.get("strip_scripts") then stripScripts(root) end
    if Config.get("auto_smooth") then smoothSurfaces(root) end
    return root
end

-- ═══════════════════════════════════════════════════════════════════
--  MAP FOLDER DETECTION
-- ═══════════════════════════════════════════════════════════════════
local function findChildCI(parent, name)
    for _, c in ipairs(parent:GetChildren()) do
        if c.Name:lower() == name:lower() then return c end
    end
    return nil
end

local function getInnerMapFolder()
    local map = workspace:FindFirstChild("Map") or findChildCI(workspace, "map")
    if not map then return nil, "workspace.Map not found" end

    local parts = findChildCI(map, "parts")
    if parts then
        local inner = findChildCI(parts, "map")
        if inner then return inner end
        return parts
    end

    local inner2 = findChildCI(map, "map")
    if inner2 then return inner2 end

    return map
end

-- ═══════════════════════════════════════════════════════════════════
--  SPAWN HANDLING
-- ═══════════════════════════════════════════════════════════════════
local function clearSpawnLocations(container)
    for _, d in ipairs(container:GetDescendants()) do
        if d:IsA("SpawnLocation") then
            pcall(function() d:Destroy() end)
        end
    end
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("SpawnLocation") then
            local insideChar = false
            local char = player.Character
            if char and d:IsDescendantOf(char) then insideChar = true end
            if not insideChar then
                pcall(function() d:Destroy() end)
            end
        end
    end
end

local function findSpawnInAsset(asset)
    for _, d in ipairs(asset:GetDescendants()) do
        if d:IsA("SpawnLocation") then return d end
    end
    return nil
end

-- ═══════════════════════════════════════════════════════════════════
--  MAP REPLACEMENT
-- ═══════════════════════════════════════════════════════════════════
local function replaceMap(asset)
    local inner, err = getInnerMapFolder()
    if not inner then return false, err end

    if Config.get("clear_spawns") then
        clearSpawnLocations(inner)
    end

    for _, child in ipairs(inner:GetChildren()) do
        pcall(function() child:Destroy() end)
    end

    asset.Parent = inner
    return true, inner
end

local function getPivot(asset)
    if asset:IsA("Model") then
        local ok, cf = pcall(function() return asset:GetPivot() end)
        if ok then return cf end
        local ok2, box = pcall(function() return asset:GetBoundingBox() end)
        if ok2 then return box end
    elseif asset:IsA("BasePart") then
        return asset.CFrame
    elseif asset:IsA("Folder") then
        for _, d in ipairs(asset:GetDescendants()) do
            if d:IsA("BasePart") then return d.CFrame end
        end
    end
    return CFrame.new(0, 0, 0)
end

local function getCharacter()
    local char = player.Character
    if not char or not char.Parent then
        char = player.CharacterAdded:Wait()
    end
    return char
end

local function giveForceField(char, dur)
    local ff = Instance.new("ForceField")
    ff.Visible = false
    ff.Parent = char
    task.delay(dur or 8, function()
        if ff and ff.Parent then ff:Destroy() end
    end)
end

local function teleportToSpawn(asset)
    local spawnPart = findSpawnInAsset(asset)
    if spawnPart and Config.get("use_asset_spawn") then
        local char = getCharacter()
        local target = spawnPart.Position + Vector3.new(0, 4, 0)
        pcall(function() char:PivotTo(CFrame.new(target)) end)
        giveForceField(char, 3)
        return "asset spawn"
    end

    local char = getCharacter()
    local pivot = getPivot(asset)
    pcall(function() char:PivotTo(CFrame.new(pivot.Position + Vector3.new(0, 100, 0))) end)
    giveForceField(char, 8)
    return "100 studs above"
end

