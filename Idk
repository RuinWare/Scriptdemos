RunService.Heartbeat:Connect(function(dt)
    if not speedChangerEnabled then return end
    if not speedHum or not speedRoot then return end
    if speedHum.Health <= 0 then return end

    local moveDir = speedHum.MoveDirection
    local moving = moveDir.Magnitude > 0
    local wishDir = moving and moveDir.Unit or Vector3.new(0, 0, 0)

    local grounded = speedHum.FloorMaterial ~= Enum.Material.Air

    if grounded and not isGrounded then
        isGrounded = true
        lastLandTime = tick()
        local flatSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
        local timeSinceLand = tick() - lastLandTime
        if timeSinceLand > BHOP_WINDOW or not jumpBuffered then
            local clamped = math.min(flatSpeed, targetSpeed * LANDING_SPEED_FACTOR)
            if flatSpeed > 0 then
                local scale = clamped / flatSpeed
                velocity = Vector3.new(velocity.X * scale, velocity.Y, velocity.Z * scale)
            end
        end
    elseif not grounded then
        isGrounded = false
    end

    if grounded then
        velocity = applyFriction(velocity, dt)
        if moving then
            local wishSpeed = targetSpeed
            if jumpedBackwards then
                wishSpeed = targetSpeed * 0.25
            elseif speedRoot.CFrame.LookVector:Dot(wishDir) < 0 then
                wishSpeed = targetSpeed * 0.5
            end
            velocity = accelerate(velocity, wishDir, wishSpeed, SV_ACCEL, dt)
        end
    end

    local flatVel = Vector3.new(velocity.X, 0, velocity.Z)
    if flatVel.Magnitude > targetSpeed then
        local scale = targetSpeed / flatVel.Magnitude
        velocity = Vector3.new(velocity.X * scale, velocity.Y, velocity.Z * scale)
    end

    if velocity.Magnitude > 0.1 then
        speedRoot.CFrame = speedRoot.CFrame + velocity * dt
    end

    currentSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
    speedSetLabel(currentSpeed)
end)

