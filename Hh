-- Y Lock
RunService.RenderStepped:Connect(function()
    if yLockEnabled and yLockValue and hrp and hrp.Parent then
        local p = hrp.Position
        local look = hrp.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
        flat = flat.Unit
        hrp.CFrame = CFrame.lookAt(
            Vector3.new(p.X, yLockValue, p.Z),
            Vector3.new(p.X, yLockValue, p.Z) + flat)
        local v = hrp.AssemblyLinearVelocity
        if math.abs(v.Y) > 0.1 then hrp.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z) end
    end
end)

