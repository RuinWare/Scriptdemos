-- ============ MAIN LOOP ============
local isInAir = false
local airStartTime, airTime = 0, 0
local lastFloorMaterial = Enum.Material.Air
local lastFallSpeed = 0
local lastHorizontalVel = Vector3.zero
local lastTrimpTime = 0
local lastWallLaunchTime = 0
local movementStartTime = 0
local wasMoving = false
local lastJumpingState = false
local justJumpedFlag = false
local airMode = nil
local airDirRelative = "forward"
local legitJumpPending = nil
local iraActive = false
local iraStartTime = 0

task.spawn(function()
    UserInputService.JumpRequest:Connect(function()
        justJumpedFlag = true
        task.wait(0.15)
        justJumpedFlag = false
    end)
end)

RunService.Heartbeat:Connect(function(dt)
    if not humanoid or not hrp or not hrp.Parent or humanoid.Health <= 0 then return end

    local currentMaterial = humanoid.FloorMaterial
    local isAir = currentMaterial == Enum.Material.Air
    local velocity = hrp.AssemblyLinearVelocity
    local now = tick()
    local md = humanoid.MoveDirection
    local cam = camera

    if isAir then
        if not isInAir then
            isInAir = true
            airStartTime = now
            lastFallSpeed = 0
            lastHorizontalVel = Vector3.zero
            if md.Magnitude > 0.1 and cam then
                local camFlat = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
                if camFlat.Magnitude > 0.01 then
                    camFlat = camFlat.Unit
                    local moveFlat = Vector3.new(md.X, 0, md.Z)
                    if moveFlat.Magnitude > 0.05 then
                        airDirRelative = moveFlat.Unit:Dot(camFlat) >= 0 and "forward" or "backward"
                    end
                end
                airMode = justJumpedFlag and "jump" or "fall"
            else
                airMode = nil
            end
        end
        airTime = now - airStartTime
        if velocity.Y < 0 then lastFallSpeed = math.abs(velocity.Y) end
        lastHorizontalVel = Vector3.new(velocity.X, 0, velocity.Z)
    end

    local justLanded = (lastFloorMaterial == Enum.Material.Air and not isAir)

    if justLanded then
        local landedAirTime = airTime
        local fallSpeed = lastFallSpeed
        local horizVel = lastHorizontalVel
        isInAir = false
        airTime = 0
        lastFallSpeed = 0
        if jumpForce then jumpForce:Destroy(); jumpForce = nil end
        airMode = nil
        airDirRelative = "forward"
        if speedEnabled and md.Magnitude > 0.05 then
            movementStartTime = now
            wasMoving = true
        end
        local angle = getFloorAngle()

        if easyBounceEnabled and landedAirTime >= 1.6 then
            if angle and angle >= 8 and angle <= 68 and fallSpeed > 5 then
                hrp.AssemblyLinearVelocity = Vector3.new(horizVel.X, fallSpeed * BOUNCE_COEFF * EASY_BOUNCE_MULT, horizVel.Z)
            end
        end
        if hardBounceEnabled and landedAirTime >= 1.6 and fallSpeed > 5 then
            hrp.AssemblyLinearVelocity = Vector3.new(horizVel.X, fallSpeed * BOUNCE_COEFF * HARD_BOUNCE_MULT, horizVel.Z)
        end
        if legitBounceEnabled and landedAirTime >= 1.6 then
            if angle and angle >= 8 and angle <= 68 and fallSpeed > 5 then
                hrp.AssemblyLinearVelocity = Vector3.new(horizVel.X, fallSpeed * BOUNCE_COEFF * LEGIT_BOUNCE_MULT, horizVel.Z)
            end
        end
        if emoteFlingEnabled and landedAirTime >= 1.6 then
            if angle and angle >= 8 and angle <= 68 and fallSpeed > 5 then
                hrp.AssemblyLinearVelocity = Vector3.new(horizVel.X, fallSpeed * BOUNCE_COEFF * EMOTE_FLING_MULT, horizVel.Z)
            end
        end
    end

    if autoJumpEnabled and isGrounded() then
        local angle = getFloorAngle()
        if angle == nil or angle < 25 then tryJump() end
    end
    if legitJumpEnabled then
        if legitJumpPending and now >= legitJumpPending then
            legitJumpPending = nil
            tryJump()
        elseif isGrounded() and not legitJumpPending then
            local angle = getFloorAngle()
            if angle == nil or angle < 25 then legitJumpPending = now + legitJumpDelay end
        end
    end

    -- ============ JUMP MACRO (fixed speed) ============
    if jumpMacroEnabled and isGrounded() then
        local allow = true
        if jmOnlyLookDown and cam then
            if cam.CFrame.LookVector.Y > -0.75 then allow = false end
        end
        if jmOnlyMove then
            local hasInput = getMovementInput()
            if not hasInput then allow = false end
        end
        if allow then
            if now - jmLastJumpTime >= jmSpeed then
                jmLastJumpTime = now
                tryJump()
            end
        end
    end

    if downFlyEnabled and cam then
        if cam.CFrame.LookVector.Y < DOWN_FLY_THRESH then
            hrp.AssemblyLinearVelocity = Vector3.new(velocity.X, getJumpVelocity(), velocity.Z)
        end
    end

    if jumpHeightEnabled and humanoid then
        pcall(function()
            humanoid.UseJumpPower = false
            humanoid.JumpHeight = jumpHeightValue
        end)
    end

    local isJumping = humanoid:GetState() == Enum.HumanoidStateType.Jumping
    if isJumping and not lastJumpingState and jumpSpeedMultEnabled then
        local mult = jumpSpeedMultValue
        hrp.AssemblyLinearVelocity = Vector3.new(velocity.X, velocity.Y * mult, velocity.Z)
        if not jumpForce or not jumpForce.Parent then
            jumpForce = Instance.new("BodyForce")
            jumpForce.Name = "RuinWareJumpForce"
            jumpForce.Parent = hrp
        end
        local extraG = workspace.Gravity * (mult * mult - 1)
        jumpForce.Force = Vector3.new(0, hrp.AssemblyMass * extraG, 0)
    end
    lastJumpingState = isJumping
    if not isAir and jumpForce then jumpForce:Destroy(); jumpForce = nil end

    -- Bypass Unmovable Emotes
    if bypassEmotesEnabled and humanoid then
        humanoid.WalkSpeed = 8.7
        local moveDir = Vector3.new(md.X, 0, md.Z)
        if moveDir.Magnitude > 0.05 then
            moveDir = moveDir.Unit
            hrp.AssemblyLinearVelocity = Vector3.new(moveDir.X * 8.7, velocity.Y, moveDir.Z * 8.7)
        end
    else
        if humanoid and humanoid.WalkSpeed == 8.7 and not speedEnabled then
            humanoid.WalkSpeed = defaultWalkSpeed
        end
    end

    -- Speed (STP)
    if speedEnabled then
        if isAir then
            if airMode and cam then
                if not speedBV or speedBV.Parent ~= hrp then createSpeedBV() end
                local camFlat = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
                if camFlat.Magnitude > 0.01 then camFlat = camFlat.Unit end
                local dir = airDirRelative == "forward" and camFlat or -camFlat
                local mult
                if airMode == "jump" and airDirRelative == "forward" then mult = 1.23
                else mult = 0.05 end
                local targetSpeed = stpValue * mult
                if speedBV then
                    speedBV.MaxForce = Vector3.new(math.huge, 0, math.huge)
                    speedBV.Velocity = Vector3.new(dir.X * targetSpeed, 0, dir.Z * targetSpeed)
                end
            end
        else
            local moving = md.Magnitude > 0.05
            if moving then
                if not wasMoving then
                    local backward = false
                    if cam then
                        local camFlat = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
                        if camFlat.Magnitude > 0.01 then
                            camFlat = camFlat.Unit
                            local moveFlat = Vector3.new(md.X, 0, md.Z)
                            if moveFlat.Magnitude > 0.05 then
                                if moveFlat.Unit:Dot(camFlat) < 0 then backward = true end
                            end
                        end
                    end
                    movementStartTime = backward and 0 or now
                end
                wasMoving = true
                if (now - movementStartTime) >= speedDelay then
                    if not speedBV or speedBV.Parent ~= hrp then createSpeedBV() end
                    if speedBV then
                        local moveDir = Vector3.new(md.X, 0, md.Z)
                        if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end
                        local speedMult = 1
                        if cam then
                            local camFlat = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
                            if camFlat.Magnitude > 0.01 then
                                camFlat = camFlat.Unit
                                if moveDir:Dot(camFlat) < 0 then speedMult = 0.5 end
                            end
                        end
                        local targetSpeed = stpValue * speedMult
                        speedBV.MaxForce = Vector3.new(math.huge, 0, math.huge)
                        speedBV.Velocity = Vector3.new(moveDir.X * targetSpeed, 0, moveDir.Z * targetSpeed)
                    end
                else
                    if speedBV then speedBV.MaxForce = Vector3.zero; speedBV.Velocity = Vector3.zero end
                end
            else
                if speedBV then speedBV.MaxForce = Vector3.zero; speedBV.Velocity = Vector3.zero end
                wasMoving = false
                movementStartTime = 0
            end
        end
    else
        if speedBV then destroySpeedBV() end
        wasMoving = false
        movementStartTime = 0
    end

    -- Instant Run Acceleration
    if iraEnabled then
        local moving = md.Magnitude > 0.05 and isGrounded()
        if moving and not iraActive then
            iraActive = true
            iraStartTime = now
        end
        if iraActive then
            if now - iraStartTime < 5 then
                if not iraBV or iraBV.Parent ~= hrp then
                    if iraBV then iraBV:Destroy() end
                    iraBV = Instance.new("BodyVelocity")
                    iraBV.Name = "RuinWareIraBV"
                    iraBV.MaxForce = Vector3.new(math.huge, 0, math.huge)
                    iraBV.P = math.huge
                    iraBV.Parent = hrp
                end
                if moving then
                    local moveDir = Vector3.new(md.X, 0, md.Z).Unit
                    iraBV.Velocity = Vector3.new(moveDir.X * 33.3, 0, moveDir.Z * 33.3)
                else
                    iraBV.Velocity = Vector3.zero
                end
            else
                iraActive = false
                if iraBV then iraBV:Destroy(); iraBV = nil end
            end
        end
    else
        iraActive = false
        if iraBV then iraBV:Destroy(); iraBV = nil end
    end

    -- Fly
    if flyEnabled then
        if not flyBV or flyBV.Parent ~= hrp then
            if flyBV then flyBV:Destroy() end
            flyBV = Instance.new("BodyVelocity")
            flyBV.Name = "RuinWareFlyBV"
            flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            flyBV.P = math.huge
            flyBV.Parent = hrp
        end
        if flyBV and cam then flyBV.Velocity = cam.CFrame.LookVector * flySpeed end
    elseif flyBV then flyBV:Destroy(); flyBV = nil end

    if gravityEnabled then pcall(function() workspace.Gravity = gravityValue end) end

    if edgeTrimpEnabled and isAir and now - lastTrimpTime > 0.5 then
        if md.Magnitude > 0.1 then
            local forward = Vector3.new(md.X, 0, md.Z).Unit
            rayParams.FilterDescendantsInstances = {character}
            local hit = workspace:Raycast(hrp.Position, forward * 2.5, rayParams)
            if hit and math.abs(hit.Normal.Y) < 0.3 then
                local topOrigin = hit.Position + Vector3.new(0, 8, 0) + forward * 0.3
                local topHit = workspace:Raycast(topOrigin, Vector3.new(0, -16, 0), rayParams)
                if topHit then
                    local edgeY = topHit.Position.Y
                    if math.abs(hrp.Position.Y - edgeY) < 2.25 then
                        hrp.AssemblyLinearVelocity = Vector3.new(
                            velocity.X + forward.X * 8, edgeTrimpPower, velocity.Z + forward.Z * 8)
                        lastTrimpTime = now
                    end
                end
            end
        end
    end

    if wallLaunchEndTime > 0 and now > wallLaunchEndTime then
        if wallLaunchBV then wallLaunchBV:Destroy(); wallLaunchBV = nil end
        wallLaunchEndTime = 0
    end
    if wallLaunchEnabled and isAir and now - lastWallLaunchTime > 0.4 and not wallLaunchBV then
        local dirs = {hrp.CFrame.RightVector, -hrp.CFrame.RightVector, hrp.CFrame.LookVector, -hrp.CFrame.LookVector}
        for _, dir in ipairs(dirs) do
            rayParams.FilterDescendantsInstances = {character}
            local hit = workspace:Raycast(hrp.Position, dir.Unit * 3, rayParams)
            if hit and math.abs(hit.Normal.Y) < 0.3 then
                local launchDir = Vector3.new(hit.Normal.X, 0, hit.Normal.Z)
                if launchDir.Magnitude > 0.01 then
                    launchDir = launchDir.Unit
                    wallLaunchBV = Instance.new("BodyVelocity")
                    wallLaunchBV.Name = "RuinWareWallLaunchBV"
                    wallLaunchBV.Velocity = Vector3.new(launchDir.X * wallLaunchPower, 0, launchDir.Z * wallLaunchPower)
                    wallLaunchBV.MaxForce = Vector3.new(math.huge, 0, math.huge)
                    wallLaunchBV.P = math.huge
                    wallLaunchBV.Parent = hrp
                    wallLaunchEndTime = now + 0.6
                    lastWallLaunchTime = now
                end
                break
            end
        end
    end

    jumpModule.update()
    lastFloorMaterial = currentMaterial
end)

-- Emote Spin (Y-axis, AlignOrientation)
local emoteSpinAngle = 0
local emoteSpinLastStep = 0
local emoteSpinAtt, emoteSpinAlign, emoteSpinSavedAutoRotate

RunService.Heartbeat:Connect(function()
    if not humanoid or not hrp or not hrp.Parent then return end
    if emoteSpinEnabled then
        if not emoteSpinAlign then
            emoteSpinAtt = Instance.new("Attachment")
            emoteSpinAtt.Name = "RuinWareSpinAtt"
            emoteSpinAtt.Parent = hrp
            emoteSpinAlign = Instance.new("AlignOrientation")
            emoteSpinAlign.Name = "RuinWareSpinAlign"
            emoteSpinAlign.Mode = Enum.OrientationAlignmentMode.OneAttachment
            emoteSpinAlign.Attachment0 = emoteSpinAtt
            emoteSpinAlign.MaxTorque = math.huge
            emoteSpinAlign.Responsiveness = 100
            emoteSpinAlign.CFrame = CFrame.Angles(0, 0, 0)
            emoteSpinAlign.Parent = hrp
            emoteSpinSavedAutoRotate = humanoid.AutoRotate
            humanoid.AutoRotate = false
        end
        local now = tick()
        if now - emoteSpinLastStep >= emoteSpinSpeed then
            emoteSpinLastStep = now
            emoteSpinAngle = (emoteSpinAngle + 45) % 360
        end
        if emoteSpinAlign then
            emoteSpinAlign.CFrame = CFrame.Angles(0, math.rad(emoteSpinAngle), 0)
        end
    elseif emoteSpinAlign or emoteSpinAtt then
        if emoteSpinAtt then pcall(function() emoteSpinAtt:Destroy() end); emoteSpinAtt = nil end
        if emoteSpinAlign then pcall(function() emoteSpinAlign:Destroy() end); emoteSpinAlign = nil end
        if humanoid and emoteSpinSavedAutoRotate ~= nil then
            humanoid.AutoRotate = emoteSpinSavedAutoRotate
        end
        emoteSpinSavedAutoRotate = nil
        emoteSpinAngle = 0
        emoteSpinLastStep = 0
    end
end)

