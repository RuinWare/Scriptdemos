-- TAS Playback
RunService.RenderStepped:Connect(function()
    if tasPlaying and hrp and #tasData > 0 then
        if not hrp.Anchored then hrp.Anchored = true end
        local elapsed = tick() - tasPlaybackStart
        while tasPlaybackIdx <= #tasData and tasData[tasPlaybackIdx].t <= elapsed do
            tasPlaybackIdx = tasPlaybackIdx + 1
        end
        if tasPlaybackIdx > #tasData then
            if tasLoop then
                tasPlaybackStart = tick()
                tasPlaybackIdx = 1
            else
                tasPlaying = false
                hrp.Anchored = false
            end
        else
            local frame = tasData[tasPlaybackIdx]
            if frame then hrp.CFrame = frame.cf end
        end
    end
end)

