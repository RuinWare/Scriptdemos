local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function getFloorAngle()
    if not hrp or not hrp.Parent or not character then return nil end
    rayParams.FilterDescendantsInstances = {character}
    local r = workspace:Raycast(hrp.Position, Vector3.new(0, -8, 0), rayParams)
    if r then return math.deg(math.acos(math.clamp(r.Normal.Y, -1, 1))) end
    return nil
end

local function isGrounded()
    if not humanoid or humanoid.Health <= 0 then return false end
    if humanoid.FloorMaterial == Enum.Material.Air then return false end
    local s = humanoid:GetState()
    return s == Enum.HumanoidStateType.Running or s == Enum.HumanoidStateType.RunningNoPhysics or s == Enum.HumanoidStateType.Landed
end

local function tryJump()
    if not isGrounded() then return end
    if humanoid.UseJumpPower then if humanoid.JumpPower <= 0 then return end
    else if humanoid.JumpHeight <= 0 then return end end
    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
end

local function getJumpVelocity()
    if not humanoid then return 50 end
    if humanoid.UseJumpPower then return humanoid.JumpPower
    else return math.sqrt(2 * workspace.Gravity * humanoid.JumpHeight) end
end

