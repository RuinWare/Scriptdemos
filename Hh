-- ============ MODULE: DESYNC ============
desyncModule = (function()
    local active = false
    local savedCFrame = nil
    return {
        setEnabled = function(enabled)
            if enabled then
                if not character or not hrp or not humanoid then return end
                active = true
                savedCFrame = hrp.CFrame
                pcall(function()
                    humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
                    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
                end)
                task.wait(0.05)
                pcall(function() hrp.CFrame = CFrame.new(hrp.Position.X, 20000, hrp.Position.Z) end)
                task.wait(0.15)
                local ok = pcall(function() game:GetService("NetworkClient"):SetOutgoingKBPSLimit(0.001) end)
                task.wait(0.05)
                if hrp and hrp.Parent then
                    hrp.CFrame = savedCFrame
                    pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
                    pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Running) end)
                end
                notify("Desync", ok and "Frozen." or "Network API unavailable.")
            else
                if not active then return end
                active = false
                pcall(function() game:GetService("NetworkClient"):SetOutgoingKBPSLimit(1e9) end)
                task.wait(0.1)
                if hrp and hrp.Parent and savedCFrame then
                    pcall(function()
                        humanoid:ChangeState(Enum.HumanoidStateType.Running)
                        hrp.CFrame = savedCFrame
                        hrp.AssemblyLinearVelocity = Vector3.zero
                    end)
                end
            end
        end
    }
end)()

