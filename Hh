-- ============ SPEED / AIR STATE ============
local isInAir = false
local airStartTime, airTime = 0, 0
local lastFloorMaterial = Enum.Material.Air
local lastFallSpeed = 0
local lastHorizontalVel = Vector3.zero
local lastTrimpTime = 0
local lastWallLaunchTime = 0
local movementStartTime = 0
local wasMoving = false
local lastJumpingState = false

-- Air speed state
local airMode = nil              -- nil | "jump" | "fall"
local airDirRelative = "forward" -- "forward" | "backward"
local airLandPending = false

-- Jump tracking (to detect "jumped while moving" vs "walked off edge")
local justJumpedFlag = false
task.spawn(function()
    UserInputService.JumpRequest:Connect(function()
        justJumpedFlag = true
        task.wait(0.15)
        justJumpedFlag = false
    end)
end)

RunService.Heartbeat:Connect(function(dt)
    if not humanoid or not hrp or not hrp.Parent or humanoid.Health <= 0 then return end

    local currentMaterial = humanoid.FloorMaterial
    local isAir = currentMaterial == Enum.Material.Air
    local velocity = hrp.AssemblyLinearVelocity
    local now = tick()
    local md = humanoid.MoveDirection
    local cam = workspace.CurrentCamera

    if isAir then
        if not isInAir then
            isInAir = true
            airStartTime = now
            lastFallSpeed = 0
            lastHorizontalVel = Vector3.zero

            -- Determine air mode at the moment we enter air
            if justJumpedFlag and md.Magnitude > 0.1 then
                airMode = "jump"
                -- Determine forward/backward at jump moment (vs camera flat)
                if cam then
                    local camFlat = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
                    if camFlat.Magnitude > 0.01 then
                        camFlat = camFlat.Unit
                        local moveFlat = Vector3.new(md.X, 0, md.Z)
                        if moveFlat.Magnitude > 0.05 then
                            airDirRelative = moveFlat.Unit:Dot(camFlat) >= 0 and "forward" or "backward"
                        end
                    end
                end
            elseif md.Magnitude > 0.1 then
                airMode = "fall"
                if cam then
                    local camFlat = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
                    if camFlat.Magnitude > 0.01 then
                        camFlat = camFlat.Unit
                        local moveFlat = Vector3.new(md.X, 0, md.Z)
                        if moveFlat.Magnitude > 0.05 then
                            airDirRelative = moveFlat.Unit:Dot(camFlat) >= 0 and "forward" or "backward"
                        end
                    end
                end
            else
                airMode = nil
            end
        end
        airTime = now - airStartTime
        if velocity.Y < 0 then lastFallSpeed = math.abs(velocity.Y) end
        lastHorizontalVel = Vector3.new(velocity.X, 0, velocity.Z)
    end

    local justLanded = (lastFloorMaterial == Enum.Material.Air and not isAir)

    if justLanded then
        local landedAirTime = airTime
        local fallSpeed = lastFallSpeed
        local horizVel = lastHorizontalVel
        isInAir = false
        airTime = 0
        lastFallSpeed = 0
        destroyJumpForce()

        -- Reset air speed state
        airMode = nil
        airDirRelative = "forward"
        -- Restart speed delay countdown
        if speedEnabled and md.Magnitude > 0.05 then
            movementStartTime = now
            wasMoving = true
        end

        local angle = getFloorAngle()

        if easyBounceEnabled and landedAirTime >= 1.6 then
            if angle and angle >= 8 and angle <= 68 and fallSpeed > 5 then
                hrp.AssemblyLinearVelocity = Vector3.new(horizVel.X, fallSpeed * BOUNCE_COEFF * EASY_BOUNCE_MULT, horizVel.Z)
            end
        end
        if hardBounceEnabled and landedAirTime >= 1.6 and fallSpeed > 5 then
            hrp.AssemblyLinearVelocity = Vector3.new(horizVel.X, fallSpeed * BOUNCE_COEFF * HARD_BOUNCE_MULT, horizVel.Z)
        end
        if legitBounceEnabled and landedAirTime >= 1.6 then
            if angle and angle >= 8 and angle <= 68 and fallSpeed > 5 then
                hrp.AssemblyLinearVelocity = Vector3.new(horizVel.X, fallSpeed * BOUNCE_COEFF * LEGIT_BOUNCE_MULT, horizVel.Z)
            end
        end
        if emoteFlingEnabled and landedAirTime >= 1.6 then
            if angle and angle >= 8 and angle <= 68 and fallSpeed > 5 then
                hrp.AssemblyLinearVelocity = Vector3.new(horizVel.X, fallSpeed * BOUNCE_COEFF * EMOTE_FLING_MULT, horizVel.Z)
            end
        end
    end

    if autoJumpEnabled and isGrounded() then
        local angle = getFloorAngle()
        if angle == nil or angle < 25 then tryJump() end
    end
    if jumpMacroEnabled and isGrounded() then tryJump() end

    if downFlyEnabled then
        if cam and cam.CFrame.LookVector.Y < DOWN_FLY_THRESH then
            hrp.AssemblyLinearVelocity = Vector3.new(velocity.X, getJumpVelocity(), velocity.Z)
        end
    end

    -- Hip Height
    if hipHeightEnabled and humanoid then humanoid.HipHeight = hipHeightValue end

    -- Jump Height
    if jumpHeightEnabled and humanoid then
        local g = workspace.Gravity
        local targetPower = math.sqrt(2 * g * jumpHeightValue)
        if humanoid.UseJumpPower then humanoid.JumpPower = targetPower
        else humanoid.JumpHeight = jumpHeightValue end
    end

    -- Jump Speed Multiplier
    local isJumping = humanoid:GetState() == Enum.HumanoidStateType.Jumping
    if isJumping and not lastJumpingState and jumpSpeedMultEnabled then
        local mult = jumpSpeedMultValue
        hrp.AssemblyLinearVelocity = Vector3.new(velocity.X, velocity.Y * mult, velocity.Z)
        if not jumpForce or not jumpForce.Parent then
            jumpForce = Instance.new("BodyForce")
            jumpForce.Name = "RuinWareJumpForce"
            jumpForce.Parent = hrp
        end
        local extraG = workspace.Gravity * (mult * mult - 1)
        jumpForce.Force = Vector3.new(0, hrp.AssemblyMass * extraG, 0)
    end
    lastJumpingState = isJumping
    if not isAir and jumpForce then destroyJumpForce() end

    -- ===== Bypass Unmovable Emotes (always 33.3 sps while toggle is on) =====
    if bypassEmotesEnabled then
        local hasInput, dir = getMovementInput()
        if hasInput then
            local worldDir = dir
            if cam then
                local camLook = cam.CFrame.LookVector
                local camRight = cam.CFrame.RightVector
                worldDir = Vector3.new(
                    camRight.X * dir.X + camLook.X * -dir.Z,
                    0,
                    camRight.Z * dir.X + camLook.Z * -dir.Z)
            end
            if worldDir.Magnitude > 0.01 then
                worldDir = worldDir.Unit
                hrp.AssemblyLinearVelocity = Vector3.new(worldDir.X * 33.3, velocity.Y, worldDir.Z * 33.3)
            end
        end
    end

    -- ===== Speed (STP) =====
    if speedEnabled then
        if isAir then
            -- IN AIR: locked direction relative to camera, custom multipliers
            if airMode then
                if not speedBV or speedBV.Parent ~= hrp then createSpeedBV() end
                if speedBV and cam then
                    local camFlat = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
                    if camFlat.Magnitude > 0.01 then camFlat = camFlat.Unit end
                    local dir
                    if airDirRelative == "forward" then dir = camFlat
                    else dir = -camFlat end
                    local mult
                    if airMode == "jump" then mult = 1.23
                    else mult = 0.05 end
                    local targetSpeed = stpValue * mult
                    speedBV.MaxForce = Vector3.new(math.huge, 0, math.huge)
                    speedBV.Velocity = Vector3.new(dir.X * targetSpeed, 0, dir.Z * targetSpeed)
                end
            else
                if speedBV then speedBV.MaxForce = Vector3.zero; speedBV.Velocity = Vector3.zero end
            end
        else
            -- ON GROUND
            local moving = md.Magnitude > 0.05
            if moving and not wasMoving then movementStartTime = now end
            wasMoving = moving

            if moving then
                if (now - movementStartTime) >= speedDelay then
                    if not speedBV or speedBV.Parent ~= hrp then createSpeedBV() end
                    if speedBV then
                        local moveDir = Vector3.new(md.X, 0, md.Z)
                        if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end
                        local speedMult = 1
                        if cam then
                            local camFlat = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
                            if camFlat.Magnitude > 0.01 then
                                camFlat = camFlat.Unit
                                if moveDir:Dot(camFlat) < 0 then speedMult = 0.5 end
                            end
                        end
                        local targetSpeed = stpValue * speedMult
                        speedBV.MaxForce = Vector3.new(math.huge, 0, math.huge)
                        speedBV.Velocity = Vector3.new(moveDir.X * targetSpeed, 0, moveDir.Z * targetSpeed)
                    end
                else
                    if speedBV then speedBV.MaxForce = Vector3.zero; speedBV.Velocity = Vector3.zero end
                end
            else
                if speedBV then speedBV.MaxForce = Vector3.zero; speedBV.Velocity = Vector3.zero end
                movementStartTime = 0
            end
        end
    else
        if speedBV then destroySpeedBV() end
        wasMoving = false
        movementStartTime = 0
    end

    -- Fly
    if flyEnabled then
        if not flyBV or flyBV.Parent ~= hrp then createFlyBV() end
        if flyBV and cam then flyBV.Velocity = cam.CFrame.LookVector * flySpeed end
    elseif flyBV then destroyFlyBV() end

    -- Noclip: disable character collision, snap to floor via raycast
    if noclipEnabled and character then
        if hrp then hrp.CanCollide = false end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
        end
        -- Floor snap: keep player standing on surfaces
        rayParams.FilterDescendantsInstances = {character}
        local snapRay = workspace:Raycast(hrp.Position + Vector3.new(0, 1, 0), Vector3.new(0, -8, 0), rayParams)
        if snapRay and snapRay.Normal.Y > 0.5 and velocity.Y <= 0 then
            local targetY = snapRay.Position.Y + 3
            if hrp.Position.Y < targetY then
                hrp.CFrame = CFrame.new(hrp.Position.X, targetY, hrp.Position.Z) * (hrp.CFrame - hrp.Position)
                hrp.AssemblyLinearVelocity = Vector3.new(velocity.X, 0, velocity.Z)
            end
        end
    end

    -- Gravity
    if gravityEnabled then pcall(function() workspace.Gravity = gravityValue end) end

    -- Easy Edge Trimp
    if edgeTrimpEnabled and isAir and now - lastTrimpTime > 0.5 then
        if md.Magnitude > 0.1 then
            local forward = Vector3.new(md.X, 0, md.Z).Unit
            rayParams.FilterDescendantsInstances = {character}
            local hit = workspace:Raycast(hrp.Position, forward * 2.5, rayParams)
            if hit and math.abs(hit.Normal.Y) < 0.3 then
                local topOrigin = hit.Position + Vector3.new(0, 8, 0) + forward * 0.3
                local topHit = workspace:Raycast(topOrigin, Vector3.new(0, -16, 0), rayParams)
                if topHit then
                    local edgeY = topHit.Position.Y
                    if math.abs(hrp.Position.Y - edgeY) < 2.25 then
                        hrp.AssemblyLinearVelocity = Vector3.new(
                            velocity.X + forward.X * 8, edgeTrimpPower, velocity.Z + forward.Z * 8)
                        lastTrimpTime = now
                    end
                end
            end
        end
    end

    -- Wall Launch (horizontal only)
    if wallLaunchEnabled and isAir and now - lastWallLaunchTime > 0.4 then
        local dirs = {hrp.CFrame.RightVector, -hrp.CFrame.RightVector, hrp.CFrame.LookVector, -hrp.CFrame.LookVector}
        for _, dir in ipairs(dirs) do
            rayParams.FilterDescendantsInstances = {character}
            local hit = workspace:Raycast(hrp.Position, dir.Unit * 3, rayParams)
            if hit and math.abs(hit.Normal.Y) < 0.3 then
                local launchDir = Vector3.new(hit.Normal.X, 0, hit.Normal.Z)
                if launchDir.Magnitude > 0.01 then
                    launchDir = launchDir.Unit
                    hrp.AssemblyLinearVelocity = Vector3.new(
                        launchDir.X * wallLaunchPower, 0, launchDir.Z * wallLaunchPower)
                    lastWallLaunchTime = now
                end
                break
            end
        end
    end

    jumpModule.update()
    lastFloorMaterial = currentMaterial
end)

