jumpModule = (function()
    local mode, bv = nil, nil
    local function destroyBV() if bv then pcall(function() bv:Destroy() end); bv = nil end end
    local function createBV()
        destroyBV()
        if not hrp then return end
        bv = Instance.new("BodyVelocity")
        bv.Name = "RuinWareJumpBV"
        bv.Velocity = Vector3.zero
        bv.MaxForce = Vector3.new(math.huge, 0, math.huge)
        bv.P = math.huge
        bv.Parent = hrp
    end
    local function restore()
        destroyBV()
        if humanoid then humanoid.WalkSpeed = defaultWalkSpeed end
    end
    return {
        setMode = function(m) mode = m; if m then createBV() else restore() end end,
        getMode = function() return mode end,
        update = function()
            if not mode or not humanoid or not hrp or humanoid.Health <= 0 then return end
            if not bv or not bv.Parent then createBV() end
            local cam = workspace.CurrentCamera
            if not cam then return end
            local look = cam.CFrame.LookVector
            local dir = Vector3.new(look.X, 0, look.Z)
            if dir.Magnitude > 0.001 then dir = dir.Unit else dir = Vector3.new(0, 0, -1) end
            local speed = (mode == "front") and FRONT_JUMP_SPEED or BACK_JUMP_SPEED
            local pushDir = (mode == "front") and dir or -dir
            if bv then bv.Velocity = Vector3.new(pushDir.X * speed, 0, pushDir.Z * speed) end
            if isGrounded() then tryJump() end
        end,
        refresh = function() if mode then createBV() end end
    }
end)()

