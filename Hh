local function getMovementInput()
    local dir = Vector3.zero
    local hasInput = false
    pcall(function()
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Vector3.new(0, 0, -1); hasInput = true end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir + Vector3.new(0, 0, 1); hasInput = true end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir + Vector3.new(-1, 0, 0); hasInput = true end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Vector3.new(1, 0, 0); hasInput = true end
    end)
    if not hasInput then
        local pg = player:FindFirstChild("PlayerGui")
        if pg then
            local tg = pg:FindFirstChild("TouchGui")
            if tg and tg.Enabled then
                local stick = tg:FindFirstChild("Thumbstick", true)
                if stick then
                    local thumb = stick:FindFirstChild("Thumbstick", true)
                        or stick:FindFirstChildWhichIsA("ImageLabel", true)
                    if thumb then
                        local px, py = thumb.Position.X.Offset, thumb.Position.Y.Offset
                        if math.abs(px) > 2 or math.abs(py) > 2 then
                            hasInput = true
                            dir = Vector3.new(px, 0, py)
                        end
                    end
                end
            end
        end
    end
    if hasInput and dir.Magnitude > 0.01 then dir = dir.Unit end
    return hasInput, dir
end

-- ============ ESP ============
local espScreenGui = Instance.new("ScreenGui")
espScreenGui.Name = "RuinWareESP"
espScreenGui.ResetOnSpawn = false
espScreenGui.DisplayOrder = 2147483000
espScreenGui.IgnoreGuiInset = true
espScreenGui.Parent = uiParent

local espBoxes = {}      -- [player] = Frame
local espLabels = {}     -- [player] = BillboardGui
local espHighlights = {} -- [player] = Highlight

local function clearBoxEsp()
    for _, frame in pairs(espBoxes) do
        if frame and frame.Parent then frame:Destroy() end
    end
    espBoxes = {}
end

local function clearDistanceEsp()
    for _, bg in pairs(espLabels) do
        if bg and bg.Parent then bg:Destroy() end
    end
    espLabels = {}
end

local function clearHighlighter()
    for _, hl in pairs(espHighlights) do
        if hl and hl.Parent then hl:Destroy() end
    end
    espHighlights = {}
end

local function updateEsp()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == player then continue end
        local char = plr.Character
        local charHrp = char and char:FindFirstChild("HumanoidRootPart")
        local charHead = char and char:FindFirstChild("Head")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (char and charHrp and hum and hum.Health > 0) then
            -- Clean up stale entries
            if espBoxes[plr] then espBoxes[plr]:Destroy(); espBoxes[plr] = nil end
            if espLabels[plr] then espLabels[plr]:Destroy(); espLabels[plr] = nil end
            if espHighlights[plr] then espHighlights[plr]:Destroy(); espHighlights[plr] = nil end
            continue
        end

        -- === Box ESP ===
        if boxEspEnabled then
            if not espBoxes[plr] then
                local f = Instance.new("Frame")
                f.Name = "ESP_" .. plr.Name
                f.BackgroundTransparency = 1
                f.BorderSizePixel = 0
                f.Parent = espScreenGui
                local stroke = Instance.new("UIStroke")
                stroke.Color = Color3.fromRGB(255, 255, 255)
                stroke.Thickness = 1.5
                stroke.Parent = f
                espBoxes[plr] = f
            end
            local f = espBoxes[plr]
            local headPos, onScreenHead = camera:WorldToViewportPoint(charHrp.Position + Vector3.new(0, 3, 0))
            local footPos, onScreenFoot = camera:WorldToViewportPoint(charHrp.Position - Vector3.new(0, 3, 0))
            if onScreenHead and onScreenFoot then
                -- Distance-based resizing: closer = bigger, farther = smaller
                local distance = (camera.CFrame.Position - charHrp.Position).Magnitude
                local scale = math.clamp(200 / math.max(distance, 1), 0.4, 2.2)
                local boxTop = headPos.Y
                local boxBottom = footPos.Y
                local midX = (headPos.X + footPos.X) / 2
                local boxHeight = math.abs(boxBottom - boxTop) * scale
                local boxWidth = boxHeight * 0.55
                boxHeight = math.abs(boxBottom - boxTop)
                boxWidth = boxHeight * 0.55 * scale
                f.Visible = true
                f.Size = UDim2.new(0, boxWidth, 0, boxHeight)
                f.Position = UDim2.new(0, midX - boxWidth / 2, 0, math.min(boxTop, boxBottom))
            else
                f.Visible = false
            end
        else
            if espBoxes[plr] then espBoxes[plr]:Destroy(); espBoxes[plr] = nil end
        end

        -- === Distance ===
        if distanceEnabled then
            if not espLabels[plr] then
                local bg = Instance.new("BillboardGui")
                bg.Name = "Dist_" .. plr.Name
                bg.Size = UDim2.new(0, 100, 0, 20)
                bg.StudsOffset = Vector3.new(0, 3.5, 0)
                bg.AlwaysOnTop = true
                bg.Parent = charHead or charHrp
                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(1, 0, 1, 0)
                lbl.BackgroundTransparency = 1
                lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                lbl.TextStrokeTransparency = 0
                lbl.TextSize = 14
                lbl.Font = Enum.Font.GothamBold
                lbl.Text = "0M"
                lbl.Parent = bg
                espLabels[plr] = bg
            end
            local bg = espLabels[plr]
            if bg and bg.Parent then
                local dist = (camera.CFrame.Position - charHrp.Position).Magnitude
                local label = bg:FindFirstChildOfClass("TextLabel")
                if label then label.Text = string.format("%dM", math.floor(dist)) end
            end
        else
            if espLabels[plr] then espLabels[plr]:Destroy(); espLabels[plr] = nil end
        end

        -- === Highlighter ===
        if highlighterEnabled then
            if not espHighlights[plr] or not espHighlights[plr].Parent then
                local hl = Instance.new("Highlight")
                hl.Name = "RuinWareHL"
                hl.FillColor = Color3.fromRGB(255, 255, 255)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.5
                hl.OutlineTransparency = 0
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = char
                espHighlights[plr] = hl
            end
        else
            if espHighlights[plr] then espHighlights[plr]:Destroy(); espHighlights[plr] = nil end
        end
    end
end

