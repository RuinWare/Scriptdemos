local function hideHud()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return end
    for _, gui in ipairs(pg:GetChildren()) do
        if gui:IsA("ScreenGui") then
            local nm = gui.Name:lower()
            if not (nm:find("chat") or nm:find("rayfield") or nm:find("touchgui") or nm:find("ruinware")) then
                hiddenHudStates[gui] = gui.Enabled
                gui.Enabled = false
            end
        end
    end
end
local function restoreHud()
    for gui, state in pairs(hiddenHudStates) do
        if gui and gui.Parent then gui.Enabled = state end
    end
    hiddenHudStates = {}
end

