            table.remove(hcParts, i)
        elseif hrp and hrp.Parent and (hcFollowX or hcFollowY or hcFollowZ) then
            local p = entry.part.Position
            local off = entry.offset
            if hcFollowX then p = Vector3.new(hrp.Position.X + off.X, p.Y, p.Z) end
            if hcFollowY then p = Vector3.new(p.X, hrp.Position.Y + off.Y, p.Z) end
            if hcFollowZ then p = Vector3.new(p.X, p.Y, hrp.Position.Z + off.Z) end
            entry.part.Position = p
        end
    end
end)

