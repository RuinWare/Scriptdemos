keyboardOverlayModule = (function()
    local screenGui, container, dragBar, dragHitbox
    local keyFrames = {}
    local built = false
    local KEY_W, KEY_H, GAP = 38, 38, 4
    local layout = {
        { keys = {"Q", "W", "E", "R"},      offsetX = 20 },
        { keys = {"A", "S", "D", "F"},      offsetX = 10 },
        { keys = {"LeftControl", "X", "C"}, offsetX = 0 },
        { keys = {"Space"},                 offsetX = 0, spaceWidth = 122 },
    }
    local keyCodeMap = {
        Q = Enum.KeyCode.Q, W = Enum.KeyCode.W, E = Enum.KeyCode.E, R = Enum.KeyCode.R,
        A = Enum.KeyCode.A, S = Enum.KeyCode.S, D = Enum.KeyCode.D, F = Enum.KeyCode.F,
        X = Enum.KeyCode.X, C = Enum.KeyCode.C,
        LeftControl = Enum.KeyCode.LeftControl, Space = Enum.KeyCode.Space,
    }
    local displayMap = { LeftControl = "CTRL", Space = "SPACE" }
    local maxRowWidth = 0
    for _, row in ipairs(layout) do
        local w
        if row.spaceWidth then w = row.offsetX + row.spaceWidth
        else w = row.offsetX + (#row.keys * KEY_W) + ((#row.keys - 1) * GAP) end
        if w > maxRowWidth then maxRowWidth = w end
    end
    local padX, padTop, padBottom = 10, 10, 24
    local containerW = maxRowWidth + (padX * 2)
    local containerH = padTop + (#layout * (KEY_H + GAP)) - GAP + padBottom

    local function build()
        if built then return true end
        screenGui = Instance.new("ScreenGui")
        screenGui.Name = "RuinWareKeyboardOverlay"
        screenGui.ResetOnSpawn = false
        screenGui.DisplayOrder = 2147483647
        screenGui.IgnoreGuiInset = true
        screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
        screenGui.Enabled = false
        screenGui.Parent = uiParent
        container = Instance.new("Frame")
        container.Size = UDim2.new(0, containerW, 0, containerH)
        container.Position = UDim2.new(0.5, -containerW / 2, 0.7, 0)
        container.BackgroundTransparency = 1
        container.BorderSizePixel = 0
        container.Active = false
        container.Parent = screenGui
        local currentY = padTop
        for _, row in ipairs(layout) do
            local currentX = padX + row.offsetX
            if row.spaceWidth then currentX = padX + (maxRowWidth - row.spaceWidth) / 2 end
            for _, keyName in ipairs(row.keys) do
                local kc = keyCodeMap[keyName]
                if kc then
                    local thisW = KEY_W
                    if keyName == "Space" then thisW = row.spaceWidth end
                    local kf = Instance.new("Frame")
                    kf.Name = keyName
                    kf.Size = UDim2.new(0, thisW, 0, KEY_H)
                    kf.Position = UDim2.new(0, currentX, 0, currentY)
                    kf.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
                    kf.BackgroundTransparency = 0.2
                    kf.BorderSizePixel = 0
                    kf.Parent = container
                    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 10); c.Parent = kf
                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.new(1, 0, 1, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.Text = displayMap[keyName] or keyName
                    lbl.TextColor3 = Color3.fromRGB(235, 235, 240)
                    lbl.TextSize = (keyName == "Space" or keyName == "LeftControl") and 13 or 15
                    lbl.Font = Enum.Font.GothamBold
                    lbl.Parent = kf
                    keyFrames[kc] = { frame = kf, label = lbl }
                    currentX = currentX + thisW + GAP
                end
            end
            currentY = currentY + KEY_H + GAP
        end
        dragBar, dragHitbox = createDragBar(container, UDim2.new(0.5, -30, 1, -14), UDim2.new(0, 60, 0, 5))
        attachDrag(dragHitbox, container, dragBar)
        built = true
        return true
    end
    local function setPressed(kc, pressed)
        local k = keyFrames[kc]
        if not k then return end
        if pressed then
            k.frame.BackgroundColor3 = Color3.fromRGB(200, 55, 55)
            k.frame.BackgroundTransparency = 0.1
            k.label.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            k.frame.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
            k.frame.BackgroundTransparency = 0.2
            k.label.TextColor3 = Color3.fromRGB(235, 235, 240)
        end
    end
    UserInputService.InputBegan:Connect(function(i)
        if keyboardOverlayOn then setPressed(i.KeyCode, true) end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if keyboardOverlayOn then setPressed(i.KeyCode, false) end
    end)
    return {
        prebuild = function() pcall(build) end,
        setEnabled = function(e)
            if e then pcall(build); if screenGui then screenGui.Enabled = true end
            else if screenGui then screenGui.Enabled = false end end
        end
    }
end)()

