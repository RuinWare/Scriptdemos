local currentInputMethod = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled and "mobile" or "pc"
local inputMethodListeners = {}
local function setInputMethod(m)
    if currentInputMethod == m then return end
    currentInputMethod = m
    for _, fn in ipairs(inputMethodListeners) do task.spawn(fn, m) end
end
local function onInputMethodChanged(fn) table.insert(inputMethodListeners, fn) end
UserInputService.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch then setInputMethod("mobile") end
end)
UserInputService.InputChanged:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch then setInputMethod("mobile") end
end)
pcall(function()
    UserInputService.LastInputTypeChanged:Connect(function(inputType)
        if inputType == Enum.UserInputType.Touch then setInputMethod("mobile")
        elseif inputType == Enum.UserInputType.Keyboard
            or inputType == Enum.UserInputType.MouseButton1
            or inputType == Enum.UserInputType.MouseButton2
            or inputType == Enum.UserInputType.MouseMovement then setInputMethod("pc") end
    end)
end)

