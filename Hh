                            plate.Material = Enum.Material.SmoothPlastic
                            plate.Parent = workspace
                            cactusPlates[obj] = plate
                        else
                            -- Update size based on current multiplier
                            plate.Size = Vector3.new(obj.Size.X * cactusMultiplier, 1, obj.Size.Z * cactusMultiplier)
                            plate.Position = obj.Position + Vector3.new(0, obj.Size.Y / 2 + 0.5, 0)
                        end
                    end
                end
            end
        end
    end
end)

