local function computeMapBounds(target)
    local minP = Vector3.new(math.huge, math.huge, math.huge)
    local maxP = Vector3.new(-math.huge, -math.huge, -math.huge)
    local found = false
    for _, obj in ipairs(target:GetDescendants()) do
        if obj:IsA("BasePart") then
            local p, s = obj.Position, obj.Size
            minP = Vector3.new(math.min(minP.X, p.X - s.X/2), math.min(minP.Y, p.Y - s.Y/2), math.min(minP.Z, p.Z - s.Z/2))
            maxP = Vector3.new(math.max(maxP.X, p.X + s.X/2), math.max(maxP.Y, p.Y + s.Y/2), math.max(maxP.Z, p.Z + s.Z/2))
            found = true
        end
    end
    if not found then return nil, nil end
    return (minP + maxP) / 2, maxP.Y
end

