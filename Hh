local function updateEsp()
    if not camera then return end
    local camPos = camera.CFrame.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            local charHrp = char and char:FindFirstChild("HumanoidRootPart")
            local charHead = char and char:FindFirstChild("Head")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local valid = char and charHrp and hum and hum.Health > 0

            if not valid then
                if espBoxes[plr] then espBoxes[plr]:Destroy(); espBoxes[plr] = nil end
                if espLabels[plr] then espLabels[plr]:Destroy(); espLabels[plr] = nil end
            else
                if boxEspEnabled then
                    if not espBoxes[plr] or not espBoxes[plr].Parent then
                        espBoxes[plr] = createBoxFrame(plr)
                    end
                    local f = espBoxes[plr]
                    local headPos, onHead = camera:WorldToViewportPoint(charHrp.Position + Vector3.new(0, 3, 0))
                    local footPos, onFoot = camera:WorldToViewportPoint(charHrp.Position - Vector3.new(0, 3, 0))
                    if onHead and onFoot then
                        local distance = (camPos - charHrp.Position).Magnitude
                        local scale = math.clamp(60 / math.max(distance, 1) + 0.4, 0.4, 2.2)
                        local boxHeight = math.abs(footPos.Y - headPos.Y) * scale
                        local boxWidth = boxHeight * 0.55
                        local midX = (headPos.X + footPos.X) / 2
                        f.Visible = true
                        f.Size = UDim2.new(0, boxWidth, 0, boxHeight)
                        f.Position = UDim2.new(0, midX - boxWidth / 2, 0, math.min(headPos.Y, footPos.Y))
                    else
                        f.Visible = false
                    end
                else
                    if espBoxes[plr] then espBoxes[plr]:Destroy(); espBoxes[plr] = nil end
                end

                if distanceEnabled and charHead then
                    if not espLabels[plr] or not espLabels[plr].Parent then
                        local bg = Instance.new("BillboardGui")
                        bg.Name = "Dist_" .. plr.Name
                        bg.Size = UDim2.new(0, 100, 0, 20)
                        bg.StudsOffset = Vector3.new(0, 3.5, 0)
                        bg.AlwaysOnTop = true
                        bg.Parent = charHead
                        local lbl = Instance.new("TextLabel")
                        lbl.Size = UDim2.new(1, 0, 1, 0)
                        lbl.BackgroundTransparency = 1
                        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                        lbl.TextStrokeTransparency = 0
                        lbl.TextSize = 14
                        lbl.Font = Enum.Font.GothamBold
                        lbl.Text = "0M"
                        lbl.Parent = bg
                        espLabels[plr] = bg
                    end
                    local bg = espLabels[plr]
                    if bg and bg.Parent then
                        local dist = (camPos - charHrp.Position).Magnitude
                        local label = bg:FindFirstChildOfClass("TextLabel")
                        if label then label.Text = string.format("%dM", math.floor(dist)) end
                    end
                else
                    if espLabels[plr] then espLabels[plr]:Destroy(); espLabels[plr] = nil end
                end
            end
        end
    end
end

