local function attachDrag(hitbox, frame, dragBar)
    local dragging = false
    local startPos, startFramePos
    hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
           or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            startPos = input.Position
            startFramePos = frame.Position
            if dragBar then
                dragBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                dragBar.BackgroundTransparency = 0
            end
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.Touch
           and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local d = input.Position - startPos
        frame.Position = UDim2.new(
            startFramePos.X.Scale, startFramePos.X.Offset + d.X,
            startFramePos.Y.Scale, startFramePos.Y.Offset + d.Y)
    end)
    UserInputService.InputEnded:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.Touch
           or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            if dragBar then
                dragBar.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
                dragBar.BackgroundTransparency = 0.3
            end
        end
    end)
end

-- Enhanced: detects WASD, arrow keys, and mobile joystick
local function getMovementInput()
    local dir = Vector3.zero
    local hasInput = false
    pcall(function()
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Vector3.new(0, 0, -1); hasInput = true end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir + Vector3.new(0, 0, 1); hasInput = true end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir + Vector3.new(-1, 0, 0); hasInput = true end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Vector3.new(1, 0, 0); hasInput = true end
        if UserInputService:IsKeyDown(Enum.KeyCode.Up) then dir = dir + Vector3.new(0, 0, -1); hasInput = true end
        if UserInputService:IsKeyDown(Enum.KeyCode.Down) then dir = dir + Vector3.new(0, 0, 1); hasInput = true end
        if UserInputService:IsKeyDown(Enum.KeyCode.Left) then dir = dir + Vector3.new(-1, 0, 0); hasInput = true end
        if UserInputService:IsKeyDown(Enum.KeyCode.Right) then dir = dir + Vector3.new(1, 0, 0); hasInput = true end
    end)
    if not hasInput then
        local pg = player:FindFirstChild("PlayerGui")
        if pg then
            local tg = pg:FindFirstChild("TouchGui")
            if tg and tg.Enabled then
                local stick = tg:FindFirstChild("Thumbstick", true)
                if stick then
                    local thumb = stick:FindFirstChild("Thumbstick", true)
                        or stick:FindFirstChildWhichIsA("ImageLabel", true)
                    if thumb then
                        local px, py = thumb.Position.X.Offset, thumb.Position.Y.Offset
                        if math.abs(px) > 2 or math.abs(py) > 2 then
                            hasInput = true
                            dir = Vector3.new(px, 0, py)
                        end
                    end
                end
            end
        end
    end
    if hasInput and dir.Magnitude > 0.01 then dir = dir.Unit end
    return hasInput, dir
end

