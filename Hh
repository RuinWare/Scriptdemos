-- ============ HELPERS ============
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function getFloorAngle()
    if not hrp or not hrp.Parent or not character then return nil end
    rayParams.FilterDescendantsInstances = {character}
    local r = workspace:Raycast(hrp.Position, Vector3.new(0, -8, 0), rayParams)
    if r then return math.deg(math.acos(math.clamp(r.Normal.Y, -1, 1))) end
    return nil
end

local function isGrounded()
    if not humanoid or humanoid.Health <= 0 then return false end
    if humanoid.FloorMaterial == Enum.Material.Air then return false end
    local s = humanoid:GetState()
    return s == Enum.HumanoidStateType.Running or s == Enum.HumanoidStateType.RunningNoPhysics or s == Enum.HumanoidStateType.Landed
end

local function tryJump()
    if not isGrounded() then return end
    if humanoid.UseJumpPower then if humanoid.JumpPower <= 0 then return end
    else if humanoid.JumpHeight <= 0 then return end end
    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
end

local function getJumpVelocity()
    if humanoid.UseJumpPower then return humanoid.JumpPower
    else return math.sqrt(2 * workspace.Gravity * humanoid.JumpHeight) end
end

local function createDragBar(parent, position, size)
    local dragBar = Instance.new("Frame")
    dragBar.Name = "DragBar"
    dragBar.Size = size or UDim2.new(0, 60, 0, 5)
    dragBar.Position = position or UDim2.new(0.5, -30, 1, -14)
    dragBar.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
    dragBar.BackgroundTransparency = 0.3
    dragBar.BorderSizePixel = 0
    dragBar.ZIndex = 10
    dragBar.Parent = parent
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1, 0); c.Parent = dragBar

    local hitbox = Instance.new("TextButton")
    hitbox.Name = "DragHitbox"
    hitbox.Size = UDim2.new(0, 120, 0, 30)
    hitbox.AnchorPoint = Vector2.new(0.5, 0.5)
    hitbox.Position = UDim2.new(0.5, 0, 1, -10)
    hitbox.BackgroundTransparency = 1
    hitbox.Text = ""
    hitbox.ZIndex = 11
    hitbox.Parent = parent

    return dragBar, hitbox
end

local function attachDrag(hitbox, frame, dragBar)
    local dragging = false
    local startPos, startFramePos
    hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
           or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            startPos = input.Position
            startFramePos = frame.Position
            if dragBar then
                dragBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                dragBar.BackgroundTransparency = 0
            end
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.Touch
           and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local d = input.Position - startPos
        frame.Position = UDim2.new(
            startFramePos.X.Scale, startFramePos.X.Offset + d.X,
            startFramePos.Y.Scale, startFramePos.Y.Offset + d.Y)
    end)
    UserInputService.InputEnded:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.Touch
           or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            if dragBar then
                dragBar.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
                dragBar.BackgroundTransparency = 0.3
            end
        end
    end)
end

-- ============ LAG SWITCH ============
lagSwitchModule = (function()
    local screenGui, frame, dragBar, dragHitbox
    local locked, lastTapTime, active, shownMode = false, 0, false, nil

    local function trigger()
        task.spawn(function()
            local s = tick()
            while tick() - s < LAG_FREEZE_TIME do end
        end)
    end

    local function build()
        if screenGui then return true end
        screenGui = Instance.new("ScreenGui")
        screenGui.Name = "RuinWareLagSwitch"
        screenGui.ResetOnSpawn = false
        screenGui.DisplayOrder = 2147483647
        screenGui.IgnoreGuiInset = true
        screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
        screenGui.Enabled = false
        screenGui.Parent = uiParent

        frame = Instance.new("Frame")
        frame.Size = UDim2.new(0, 140, 0, 140)
        frame.Position = UDim2.new(0.5, -70, 0.35, -70)
        frame.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
        frame.BackgroundTransparency = 0.25
        frame.BorderSizePixel = 0
        frame.Active = true
        frame.Parent = screenGui

        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 18); c.Parent = frame

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -20, 1, -30)
        label.Position = UDim2.new(0, 10, 0, 10)
        label.BackgroundTransparency = 1
        label.Text = "Lag Switch"
        label.TextColor3 = Color3.fromRGB(240, 240, 240)
        label.TextSize = 18
        label.Font = Enum.Font.GothamBold
        label.TextWrapped = true
        label.TextYAlignment = Enum.TextYAlignment.Center
        label.Parent = frame

        dragBar, dragHitbox = createDragBar(frame)
        attachDrag(dragHitbox, frame, dragBar)

        local tapButton = Instance.new("TextButton")
        tapButton.Size = UDim2.new(1, 0, 1, 0)
        tapButton.BackgroundTransparency = 1
        tapButton.Text = ""
        tapButton.ZIndex = 5
        tapButton.Parent = frame
        tapButton.MouseButton1Click:Connect(function()
            local now = tick()
            if now - lastTapTime < 0.35 then locked = not locked; lastTapTime = 0; return end
            lastTapTime = now
            trigger()
        end)
        return true
    end

    local function applyCurrentMode()
        if not active then return end
        if shownMode == currentInputMethod then return end
        shownMode = currentInputMethod
        if currentInputMethod == "mobile" then
            pcall(build)
            if screenGui then screenGui.Enabled = true end
        else
            if screenGui then screenGui.Enabled = false end
            Rayfield:Notify({ Title = "Lag Switch", Content = "Press X to trigger the lag switch.",
                Duration = 4, Image = "zap" })
        end
    end

    onInputMethodChanged(function() applyCurrentMode() end)

    UserInputService.InputBegan:Connect(function(input, processed)
        if processed or not active or currentInputMethod ~= "pc" then return end
        if input.KeyCode == Enum.KeyCode.X then trigger() end
    end)

    return {
        prebuild = function() pcall(build) end,
        setEnabled = function(enabled)
            active = enabled
            if enabled then
                shownMode = nil
                applyCurrentMode()
            else
                if screenGui then screenGui.Enabled = false end
                shownMode = nil
                locked = false
            end
        end
    }
end)()

